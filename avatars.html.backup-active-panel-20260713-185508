let activeTab = "all", searchQ = "";

function getVisible() {
  return AVATARS.filter(([slug,name,cat]) => {
    const tabOk = activeTab === "all" || cat === activeTab;
    const q = searchQ.toLowerCase();
    const searchOk = !q || name.toLowerCase().includes(q) || cat.includes(q);
    return tabOk && searchOk;
  });
}

function render() {
  const visible = getVisible();
  document.getElementById("count").textContent = visible.length + " avatars";
  document.getElementById("grid").innerHTML = visible.map(([slug,name,cat]) => {
    const url = `${BASE}/${slug}.webp`;
    return `<div class="av" onclick="copy('${url}',this)">
      <img src="${url}" alt="${name}" loading="lazy" onerror="this.style.opacity='.15'">
      <div class="av-name">${name}</div>
      <div class="av-badge">Copied ✓</div>
    </div>`;
  }).join("");
}

function renderTabs() {
  document.getElementById("tabs").innerHTML = CATS.map(c =>
    `<button class="tab${c.id===activeTab?" active":""}" onclick="setTab('${c.id}')">${c.label}</button>`
  ).join("");
}

function setTab(id) { activeTab=id; renderTabs(); render(); }

let toastTimer;
function copy(url, card) {
  if (window.nuvioAvatarState && window.nuvioAvatarState.selectedProfileId) {
    window.pushAvatarToProfile(url, card);
    return;
  }
  navigator.clipboard.writeText(url).catch(()=>{
    const t=document.createElement("textarea"); t.value=url;
    t.style.position="fixed"; t.style.opacity="0";
    document.body.appendChild(t); t.select();
    document.execCommand("copy"); document.body.removeChild(t);
  });
  document.querySelectorAll(".av.copied").forEach(c=>c.classList.remove("copied"));
  card.classList.add("copied");
  setTimeout(()=>card.classList.remove("copied"),1800);
  const toast=document.getElementById("toast");
  toast.classList.add("show"); clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>toast.classList.remove("show"),2000);
}

document.getElementById("searchQ").addEventListener("input",e=>{searchQ=e.target.value;render();});
renderTabs(); render();
</script>

