<script>
(function () {
  var overlay =
    document.getElementById('umAvatarOverlay');

  var chooseButton =
    document.getElementById('umAvatarChooseBtn');

  var fileInput =
    document.getElementById('umAvatarFile');

  var cropWrap =
    document.getElementById('umAvatarCropWrap');

  var canvas =
    document.getElementById('umAvatarCanvas');

  var cropFrame =
    document.getElementById('umAvatarCropFrame');

  var zoomInput =
    document.getElementById('umAvatarZoom');

  var zoomValue =
    document.getElementById('umAvatarZoomValue');

  var saveButton =
    document.getElementById('umAvatarSaveBtn');

  var cancelButton =
    document.getElementById('umAvatarCancelBtn');

  var status =
    document.getElementById('umAvatarStatus');

  var ctx =
    canvas.getContext('2d');

  var image = null;
  var baseScale = 1;
  var zoom = 1;
  var offsetX = 0;
  var offsetY = 0;

  var dragging = false;
  var lastX = 0;
  var lastY = 0;

  function selectedProfile() {
    var state = window.nuvioAvatarState;

    if (!state || !state.selectedProfileId) {
      return null;
    }

    return state.profiles.find(function (profile) {
      return profile.profile_index ===
        state.selectedProfileId;
    }) || null;
  }

  function setStatus(message, type) {
    status.textContent = message || '';
    status.className =
      'um-avatar-status' +
      (type ? ' ' + type : '');
  }

  function ensureUploadButton() {
    var activeStage =
      document.getElementById('nuvioAvatarActiveStage');

    if (!activeStage) return;

    var existing =
      document.getElementById('umAvatarUploadBtn');

    if (!existing) {
      existing = document.createElement('button');
      existing.type = 'button';
      existing.id = 'umAvatarUploadBtn';
      existing.innerHTML =
        '<span>＋</span><span>Upload your own</span>';

      var row =
        activeStage.querySelector('div');

      if (row) {
        row.appendChild(existing);
      } else {
        activeStage.appendChild(existing);
      }

      existing.addEventListener('click', openSheet);
    }

    existing.classList.toggle(
      'show',
      !!selectedProfile()
    );
  }

  function openSheet() {
    var profile = selectedProfile();

    if (!profile) {
      var toast = document.getElementById('toast');

      if (toast) {
        toast.textContent =
          'Select a Nuvio profile first.';
        toast.classList.add('show');

        setTimeout(function () {
          toast.classList.remove('show');
        }, 2400);
      }

      return;
    }

    overlay.classList.add('open');
    setStatus('');
  }

  function closeSheet() {
    overlay.classList.remove('open');
  }

  function resetCropper() {
    image = null;
    baseScale = 1;
    zoom = 1;
    offsetX = 0;
    offsetY = 0;

    zoomInput.value = '1';
    zoomValue.textContent = '100%';

    cropWrap.classList.remove('ready');
    saveButton.disabled = true;

    ctx.clearRect(
      0,
      0,
      canvas.width,
      canvas.height
    );

    fileInput.value = '';
    setStatus('');
  }

  function clampOffsets() {
    if (!image) return;

    var scale =
      baseScale * zoom;

    var drawnWidth =
      image.naturalWidth * scale;

    var drawnHeight =
      image.naturalHeight * scale;

    var minX =
      canvas.width - drawnWidth;

    var minY =
      canvas.height - drawnHeight;

    offsetX =
      Math.min(0, Math.max(minX, offsetX));

    offsetY =
      Math.min(0, Math.max(minY, offsetY));
  }

  function drawImage() {
    if (!image) return;

    clampOffsets();

    var scale =
      baseScale * zoom;

    var width =
      image.naturalWidth * scale;

    var height =
      image.naturalHeight * scale;

    ctx.clearRect(
      0,
      0,
      canvas.width,
      canvas.height
    );

    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = 'high';

    ctx.drawImage(
      image,
      offsetX,
      offsetY,
      width,
      height
    );
  }

  function loadFile(file) {
    if (!file) return;

    if (!/^image\/(jpeg|png|webp)$/.test(file.type)) {
      setStatus(
        'Choose a JPG, PNG or WebP image.',
        'error'
      );
      return;
    }

    if (file.size > 12 * 1024 * 1024) {
      setStatus(
        'Choose an image smaller than 12 MB.',
        'error'
      );
      return;
    }

    var reader = new FileReader();

    reader.onload = function () {
      var loadedImage = new Image();

      loadedImage.onload = function () {
        image = loadedImage;

        baseScale = Math.max(
          canvas.width / image.naturalWidth,
          canvas.height / image.naturalHeight
        );

        zoom = 1;

        var width =
          image.naturalWidth * baseScale;

        var height =
          image.naturalHeight * baseScale;

        offsetX =
          (canvas.width - width) / 2;

        offsetY =
          (canvas.height - height) / 2;

        zoomInput.value = '1';
        zoomValue.textContent = '100%';

        cropWrap.classList.add('ready');
        saveButton.disabled = false;

        setStatus(
          'Drag the image to position it.'
        );

        drawImage();
      };

      loadedImage.onerror = function () {
        setStatus(
          'That image could not be opened.',
          'error'
        );
      };

      loadedImage.src = reader.result;
    };

    reader.onerror = function () {
      setStatus(
        'The selected image could not be read.',
        'error'
      );
    };

    reader.readAsDataURL(file);
  }

  chooseButton.addEventListener(
    'click',
    function () {
      fileInput.click();
    }
  );

  fileInput.addEventListener(
    'change',
    function () {
      loadFile(fileInput.files[0]);
    }
  );

  zoomInput.addEventListener(
    'input',
    function () {
      if (!image) return;

      var oldZoom = zoom;
      var newZoom =
        parseFloat(zoomInput.value) || 1;

      var centreX =
        canvas.width / 2;

      var centreY =
        canvas.height / 2;

      offsetX =
        centreX -
        (
          centreX - offsetX
        ) *
        (
          newZoom / oldZoom
        );

      offsetY =
        centreY -
        (
          centreY - offsetY
        ) *
        (
          newZoom / oldZoom
        );

      zoom = newZoom;

      zoomValue.textContent =
        Math.round(zoom * 100) + '%';

      drawImage();
    }
  );

  cropFrame.addEventListener(
    'pointerdown',
    function (event) {
      if (!image) return;

      dragging = true;
      lastX = event.clientX;
      lastY = event.clientY;

      cropFrame.setPointerCapture(
        event.pointerId
      );
    }
  );

  cropFrame.addEventListener(
    'pointermove',
    function (event) {
      if (!dragging || !image) return;

      var rect =
        cropFrame.getBoundingClientRect();

      var scaleX =
        canvas.width / rect.width;

      var scaleY =
        canvas.height / rect.height;

      offsetX +=
        (event.clientX - lastX) * scaleX;

      offsetY +=
        (event.clientY - lastY) * scaleY;

      lastX = event.clientX;
      lastY = event.clientY;

      drawImage();
    }
  );

  function stopDragging(event) {
    dragging = false;

    try {
      cropFrame.releasePointerCapture(
        event.pointerId
      );
    } catch (error) {}
  }

  cropFrame.addEventListener(
    'pointerup',
    stopDragging
  );

  cropFrame.addEventListener(
    'pointercancel',
    stopDragging
  );

  cancelButton.addEventListener(
    'click',
    closeSheet
  );

  overlay.addEventListener(
    'click',
    function (event) {
      if (event.target === overlay) {
        closeSheet();
      }
    }
  );

  saveButton.addEventListener(
    'click',
    async function () {
      var state =
        window.nuvioAvatarState;

      var profile =
        selectedProfile();

      if (
        !image ||
        !state ||
        !state.accessToken ||
        !profile
      ) {
        setStatus(
          'Select a Nuvio profile first.',
          'error'
        );
        return;
      }

      saveButton.disabled = true;
      chooseButton.disabled = true;

      try {
        setStatus(
          'Preparing avatar…'
        );

        drawImage();

        var imageData =
          canvas.toDataURL(
            'image/webp',
            0.88
          );

        setStatus(
          'Uploading avatar…'
        );

        var response = await fetch(
          '/api/avatar-upload',
          {
            method: 'POST',
            headers: {
              'Content-Type':
                'application/json'
            },
            body: JSON.stringify({
              imageData: imageData
            })
          }
        );

        var result = await response
          .json()
          .catch(function () {
            return {};
          });

        if (!response.ok || !result.url) {
          throw new Error(
            result.error ||
            'Avatar upload failed.'
          );
        }

        setStatus(
          'Updating Nuvio profile…'
        );

        var updated =
          await nuvioSetProfileAvatar(
            state.accessToken,
            state.profiles,
            state.selectedProfileId,
            result.url
          );

        state.profiles = updated;

        var updatedProfile =
          updated.find(function (item) {
            return item.profile_index ===
              state.selectedProfileId;
          });

        if (updatedProfile) {
          var activeImage =
            document.getElementById(
              'nuvioAvatarActiveImg'
            );

          if (activeImage) {
            activeImage.innerHTML = '';

            var img =
              document.createElement('img');

            img.src =
              result.url +
              '?fresh=' +
              Date.now();

            img.style.cssText =
              'width:100%;height:100%;object-fit:cover;';

            activeImage.appendChild(img);
          }
        }

        setStatus(
          'Avatar uploaded and set ✓',
          'ok'
        );

        var toast =
          document.getElementById('toast');

        if (toast) {
          toast.textContent =
            'Custom avatar set ✓';
          toast.classList.add('show');

          setTimeout(function () {
            toast.classList.remove('show');
          }, 2200);
        }

        setTimeout(function () {
          closeSheet();
          resetCropper();
        }, 1000);
      } catch (error) {
        setStatus(
          error.message ||
          'The avatar could not be set.',
          'error'
        );
      } finally {
        saveButton.disabled = !image;
        chooseButton.disabled = false;
      }
    }
  );

  var activeStage =
    document.getElementById(
      'nuvioAvatarActiveStage'
    );

  if (activeStage) {
    new MutationObserver(
      ensureUploadButton
    ).observe(
      activeStage,
      {
        attributes: true,
        attributeFilter: ['style'],
        childList: true,
        subtree: true
      }
    );
  }

  var originalSelectProfile =
    window.selectProfile;

  document.addEventListener(
    'click',
    function () {
      setTimeout(
        ensureUploadButton,
        50
      );
    }
  );

  ensureUploadButton();
})();
</script>

