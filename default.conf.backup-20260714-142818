server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Addon routes → PM2 ultra-max on port 7000
    location /gallery {
        proxy_pass http://172.23.0.1:7000/gallery;
        proxy_set_header Host $host;
    }

    client_max_body_size 10m;

    location /api/share {
        proxy_pass http://172.23.0.1:7000/api/share;
        proxy_set_header Host $host;
    }

    location /api/shares {
        proxy_pass http://172.23.0.1:7000/api/shares;
        proxy_set_header Host $host;
    }

    location /c/ {
        proxy_pass http://172.23.0.1:7000/c/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location /api/ {
        proxy_pass http://172.23.0.1:7000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location /images/avatars/ {
        alias /usr/share/nginx/html/images/avatars/;
        expires 30d;
        access_log off;
    }
    location /images/ {
        proxy_pass http://172.23.0.1:7000/images/;
        proxy_set_header Host $host;
    }
    location /assets {
        proxy_pass http://172.23.0.1:7000/assets;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location /verify/ {
        proxy_pass http://172.23.0.1:7000/verify/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location /preview/ {
        proxy_pass http://172.23.0.1:7000/preview/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /resolve/ {
        proxy_pass http://172.23.0.1:7000/resolve/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location = /public-manifest.json {
        proxy_pass http://172.23.0.1:7000/public-manifest.json;
        proxy_set_header Host $host;
    }

    location = /manifest.json {
        proxy_pass http://172.23.0.1:7000/manifest.json;
        proxy_set_header Host $host;
    }
    location = /trending {
        proxy_pass http://172.23.0.1:7000/trending;
        proxy_set_header Host $host;
    }
    location = /stats {
        proxy_pass http://172.23.0.1:7000/stats;
        proxy_set_header Host $host;
    }
    location = /logo.svg {
        proxy_pass http://172.23.0.1:7000/logo.svg;
    }
    location /catalog-defs.json {
        proxy_pass http://172.23.0.1:7000/catalog-defs.json;
        proxy_set_header Host $host;
    }

    location /collections/ {
        proxy_pass http://172.23.0.1:7000/collections/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location = /token-check {
        try_files /token-check.html =404;
    }

    location = /inspector {
        try_files /inspector.html =404;
    }

    location = /inspector.html {
        try_files /inspector.html =404;
    }

    location /auth/ {
        proxy_pass http://172.23.0.1:7000/auth/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /admin/ {
        proxy_pass http://172.23.0.1:7000/admin/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location ~ ^/configure/(.+)$ {
        return 301 https://$host/setup.html?token=$1;
    }


    # Android APK download
    location = /downloads/UltraMax.apk {
        types {
            application/vnd.android.package-archive apk;
        }

        default_type application/vnd.android.package-archive;

        add_header Content-Disposition 'attachment; filename="UltraMax.apk"' always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;

        try_files $uri =404;
    }

    # Static files
    location = /recover {
        try_files /recover.html =404;
    }

    location = /setup.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
        try_files $uri $uri/ =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
