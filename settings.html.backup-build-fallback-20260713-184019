  <script>
  (function () {
    var installedCode = 0;
    var installedName = '1.1';
    var releaseData = null;

    var installedVersion =
      document.getElementById('installedVersion');

    var installedBuild =
      document.getElementById('installedBuild');

    var latestVersion =
      document.getElementById('latestVersion');

    var latestBuild =
      document.getElementById('latestBuild');

    var status =
      document.getElementById('updateStatus');

    var downloadBtn =
      document.getElementById('downloadBtn');

    function setStatus(message, className) {
      status.textContent = message;
      status.className = 'status' +
        (className ? ' ' + className : '');
    }

    async function detectInstalledVersion() {
      try {
        var AppPlugin =
          window.Capacitor &&
          window.Capacitor.Plugins &&
          window.Capacitor.Plugins.App;

        if (!AppPlugin) {
          installedBuild.textContent =
            'Browser mode · build unavailable';
          return;
        }

        var info = await AppPlugin.getInfo();

        installedCode =
          parseInt(info.build, 10) || 0;

        installedName =
          info.version || installedName;

        installedVersion.textContent =
          installedName;

        installedBuild.textContent =
          'Build ' + installedCode;
      } catch (error) {
        installedBuild.textContent =
          'Could not read installed build';
      }
    }

    async function loadReleaseData(showResult) {
      try {
        setStatus('Checking for updates…');

        var response = await fetch(
          '/app-version.json?fresh=' + Date.now(),
          { cache: 'no-store' }
        );

        if (!response.ok) {
          throw new Error(
            'Update service returned ' + response.status
          );
        }

        releaseData = await response.json();

        var latestCode =
          parseInt(releaseData.latestVersionCode, 10) || 0;

        latestVersion.textContent =
          releaseData.latestVersionName || 'Unknown';

        latestBuild.textContent =
          'Build ' + latestCode;

        if (releaseData.downloadUrl) {
          downloadBtn.href =
            releaseData.downloadUrl;
        }

        if (latestCode > installedCode && installedCode > 0) {
          setStatus(
            'A newer version is available: ' +
            (releaseData.latestVersionName || latestCode) +
            '.',
            'update'
          );
        } else if (installedCode > 0) {
          setStatus(
            'Ultra MAX is up to date.',
            'good'
          );
        } else if (showResult) {
          setStatus(
            'Latest release loaded. Installed build could not be detected.'
          );
        } else {
          setStatus(
            'Latest release information loaded.'
          );
        }
      } catch (error) {
        latestVersion.textContent = 'Unavailable';
        latestBuild.textContent =
          'Could not reach update service';

        setStatus(
          'Update check failed. Please try again.',
          'error'
        );
      }
    }

    document
      .getElementById('checkUpdateBtn')
      .addEventListener('click', function () {
        loadReleaseData(true);
      });

    document
      .querySelectorAll('a[href]')
      .forEach(function (link) {
        var rawHref = link.getAttribute('href');

        if (!rawHref || rawHref.startsWith('#')) return;

        try {
          var url = new URL(rawHref, location.origin);

          if (url.origin !== location.origin) return;

          url.searchParams.set('native', '1');

          link.setAttribute(
            'href',
            url.pathname + url.search + url.hash
          );
        } catch (error) {}
      });

    Promise.resolve()
      .then(detectInstalledVersion)
      .then(function () {
        return loadReleaseData(false);
      });
  })();
  </script>
