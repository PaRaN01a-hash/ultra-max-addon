<!DOCTYPE html>
<html lang="en">
<head>
  <script>
  (function () {
    var params = new URLSearchParams(location.search);
    var queryNative = params.get('native') === '1';
    var storedNative = false;

    try {
      storedNative =
        sessionStorage.getItem('ultramax_native_app') === '1';
    } catch (error) {}

    if (queryNative) {
      try {
        sessionStorage.setItem('ultramax_native_app', '1');
      } catch (error) {}
    }

    if (queryNative || storedNative) {
      document.documentElement.classList.add('native-app');
    }
  })();
  </script>

  <meta charset="UTF-8">
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover"
  >

  <title>Ultra MAX · Settings</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link
    href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  >

  <style>
    * {
      box-sizing: border-box;
    }

    :root {
      --bg: #080810;
      --card: #12121f;
      --border: #23233a;
      --border2: #30304b;
      --violet: #7b2fff;
      --violet2: #9b5fff;
      --coral: #ff3d5a;
      --green: #34d399;
      --text: #eeeeF7;
      --muted: #8d8da8;
    }

    html,
    body {
      min-height: 100%;
      margin: 0;
      background:
        radial-gradient(
          circle at 50% -10%,
          rgba(123,47,255,.25),
          transparent 34%
        ),
        var(--bg);
      color: var(--text);
      font-family: Inter, sans-serif;
    }

    body {
      padding-bottom:
        calc(104px + env(safe-area-inset-bottom));
    }

    .app-header {
      position: sticky;
      top: 0;
      z-index: 5000;
      display: flex;
      min-height:
        calc(62px + env(safe-area-inset-top));
      padding:
        calc(8px + env(safe-area-inset-top))
        14px
        8px;
      align-items: center;
      gap: 12px;
      background: rgba(8,8,16,.96);
      border-bottom: 1px solid rgba(155,95,255,.18);
      box-shadow: 0 12px 34px rgba(0,0,0,.34);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
    }

    .back-button {
      width: 42px;
      height: 42px;
      flex: 0 0 42px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(155,95,255,.28);
      border-radius: 14px;
      background: rgba(255,255,255,.045);
      color: #fff;
      text-decoration: none;
      font-size: 22px;
    }

    .header-copy {
      min-width: 0;
      flex: 1;
    }

    .eyebrow {
      color: var(--violet2);
      font-size: 9px;
      font-weight: 800;
      letter-spacing: .16em;
      text-transform: uppercase;
    }

    .header-title {
      margin-top: 2px;
      font-size: 17px;
      font-weight: 800;
    }

    .page {
      width: 100%;
      max-width: 580px;
      margin: 0 auto;
      padding: 24px 16px 30px;
    }

    .brand {
      text-align: center;
      margin-bottom: 26px;
    }

    .logo {
      font-family: "Bebas Neue", sans-serif;
      font-size: 38px;
      letter-spacing: .06em;
    }

    .logo span {
      background:
        linear-gradient(135deg, var(--violet), var(--coral));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .subtitle {
      margin-top: 2px;
      color: var(--muted);
      font-size: 13px;
    }

    .section-label {
      margin: 24px 4px 10px;
      color: var(--muted);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .14em;
      text-transform: uppercase;
    }

    .card {
      overflow: hidden;
      border: 1px solid rgba(155,95,255,.22);
      border-radius: 20px;
      background:
        linear-gradient(
          145deg,
          rgba(123,47,255,.11),
          rgba(255,255,255,.025)
        );
      box-shadow: 0 18px 50px rgba(0,0,0,.22);
    }

    .row {
      min-height: 64px;
      display: flex;
      align-items: center;
      gap: 13px;
      padding: 13px 15px;
      border-bottom: 1px solid rgba(255,255,255,.055);
    }

    .row:last-child {
      border-bottom: 0;
    }

    .row-icon {
      width: 40px;
      height: 40px;
      flex: 0 0 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 13px;
      background: rgba(123,47,255,.15);
      color: var(--violet2);
    }

    .row-icon svg {
      width: 21px;
      height: 21px;
    }

    .row-copy {
      min-width: 0;
      flex: 1;
    }

    .row-title {
      color: #fff;
      font-size: 14px;
      font-weight: 700;
    }

    .row-sub {
      margin-top: 3px;
      color: var(--muted);
      font-size: 11px;
      line-height: 1.4;
      word-break: break-word;
    }

    .value {
      flex-shrink: 0;
      color: var(--muted);
      font-size: 12px;
      font-weight: 700;
    }

    button,
    .action-link {
      min-height: 46px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 11px 16px;
      border-radius: 14px;
      border: 1px solid var(--border2);
      background: rgba(255,255,255,.04);
      color: #fff;
      font-family: inherit;
      font-size: 13px;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
    }

    .primary {
      border: 0;
      background:
        linear-gradient(135deg, var(--violet), var(--coral));
      box-shadow: 0 10px 28px rgba(123,47,255,.24);
    }

    .actions {
      display: grid;
      gap: 10px;
      padding: 15px;
    }

    .status {
      min-height: 18px;
      padding: 0 15px 15px;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.45;
      text-align: center;
    }

    .status.good {
      color: var(--green);
    }

    .status.update {
      color: #fbbf24;
    }

    .status.error {
      color: #ff7a8f;
    }

    .app-bottom-nav {
      display: none;
      position: fixed;
      left: 12px;
      right: 12px;
      bottom: calc(12px + env(safe-area-inset-bottom));
      z-index: 99999;
      height: 64px;
      align-items: center;
      justify-content: space-around;
      padding: 6px 8px;
      border: 1px solid rgba(155,95,255,.3);
      border-radius: 20px;
      background: rgba(12,10,25,.96);
      box-shadow: 0 14px 45px rgba(0,0,0,.5);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
    }

    html.native-app .app-bottom-nav {
      display: flex;
    }

    .app-bottom-nav a {
      min-width: 64px;
      min-height: 48px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      border-radius: 14px;
      color: #8888aa;
      text-decoration: none;
      font-size: 10px;
      font-weight: 700;
    }

    .app-bottom-nav svg {
      width: 21px;
      height: 21px;
    }

    .legal {
      margin-top: 22px;
      color: var(--muted);
      font-size: 10px;
      line-height: 1.6;
      text-align: center;
    }
  </style>
</head>

