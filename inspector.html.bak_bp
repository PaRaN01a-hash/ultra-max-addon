<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Token Inspector — Ultra MAX Admin</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: #05050f;
    color: #e2e8f0;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    min-height: 100vh;
    padding: 28px 16px 60px;
  }

  .container { max-width: 780px; margin: 0 auto; }

  /* Header */
  .header { text-align: center; margin-bottom: 28px; }
  .header-eyebrow {
    font-size: 10px; letter-spacing: 0.25em; color: #1e3a5a;
    text-transform: uppercase; margin-bottom: 8px;
  }
  .header h1 {
    font-size: 26px; font-weight: 900;
    background: linear-gradient(90deg, #3b82f6, #8b5cf6, #06b6d4);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .header p { color: #334155; font-size: 12px; margin-top: 6px; }

  /* Search bar */
  .search-bar {
    background: #0a0a1e; border: 1px solid #1a2a4a;
    border-radius: 14px; padding: 14px; margin-bottom: 20px;
    display: flex; gap: 10px; align-items: center;
  }
  .search-bar input {
    flex: 1; background: #05050f; border: 1px solid #1a2a4a;
    border-radius: 8px; padding: 11px 14px; color: #e2e8f0;
    font-size: 15px; font-family: monospace; outline: none;
    transition: border-color 0.2s;
  }
  .search-bar input:focus { border-color: #3b82f6; }
  .search-bar input::placeholder { color: #334155; }
  .search-bar button {
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    border: none; border-radius: 8px; padding: 11px 22px;
    color: #fff; font-weight: 700; font-size: 14px;
    cursor: pointer; white-space: nowrap; transition: opacity 0.2s;
  }
  .search-bar button:disabled { opacity: 0.4; cursor: not-allowed; background: #1a2a4a; }
  .search-bar button:not(:disabled):hover { opacity: 0.85; }

  /* Error */
  .error {
    background: #150a0a; border: 1px solid #4a1a1a;
    border-radius: 10px; padding: 12px 16px;
    color: #f87171; font-size: 13px; margin-bottom: 16px;
  }

  /* Stat cards */
  .stat-row { display: flex; gap: 10px; margin-bottom: 16px; flex-wrap: wrap; }
  .stat-card {
    background: #0f0f23; border-radius: 12px; padding: 14px 18px;
    flex: 1; min-width: 90px;
  }
  .stat-value { font-size: 20px; font-weight: 800; line-height: 1; }
  .stat-sub { font-size: 10px; margin-top: 2px; }
  .stat-label { font-size: 10px; color: #475569; margin-top: 6px; text-transform: uppercase; letter-spacing: 0.06em; }

  /* Config card */
  .card {
    background: #0a0a1e; border: 1px solid #1a2a4a;
    border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;
  }
  .card-title {
    font-size: 10px; color: #334155; text-transform: uppercase;
    letter-spacing: 0.12em; margin-bottom: 12px;
  }
  .info-row {
    display: flex; justify-content: space-between; align-items: flex-start;
    padding: 7px 0; border-bottom: 1px solid #0d1a2e; gap: 12px;
  }
  .info-row:last-child { border-bottom: none; padding-bottom: 0; }
  .info-label {
    font-size: 11px; color: #475569; text-transform: uppercase;
    letter-spacing: 0.06em; white-space: nowrap; padding-top: 1px;
    flex-shrink: 0;
  }
  .info-value { font-size: 13px; text-align: right; word-break: break-all; }
  .info-value.mono { font-family: monospace; }
  .info-value.dim { color: #334155; }
  .info-value.green { color: #34d399; }
  .info-value.amber { color: #f59e0b; }
  .info-value.blue { color: #60a5fa; }
  .info-value.purple { color: #a78bfa; }
  .info-value.orange { color: #fb923c; }
  .info-value.red { color: #f87171; }

  /* Stream addon */
  .stream-addon {
    background: #080f1a; border: 1px solid #1a2a4a;
    border-radius: 8px; padding: 8px 12px; margin-bottom: 6px;
  }
  .stream-addon-host { color: #60a5fa; font-weight: 600; font-size: 13px; margin-bottom: 2px; }
  .stream-addon-url { color: #1e3a5a; font-family: monospace; font-size: 10px; word-break: break-all; }

  /* Hidden notice */
  .hidden-notice {
    background: #150a0a; border: 1px solid #4a1a1a;
    border-radius: 10px; padding: 10px 14px;
    font-size: 12px; color: #f87171; margin-bottom: 12px;
  }

  /* Section label */
  .section-label {
    font-size: 10px; color: #334155; text-transform: uppercase;
    letter-spacing: 0.12em; margin-bottom: 10px;
  }

  /* Group accordion */
  .group {
    background: #080818; border: 1px solid #1a2a3a;
    border-radius: 12px; overflow: hidden; margin-bottom: 8px;
  }
  .group-header {
    padding: 11px 16px; display: flex; justify-content: space-between;
    align-items: center; cursor: pointer; background: #0d1525;
    user-select: none;
  }
  .group-header:hover { background: #101c2e; }
  .group-title { font-weight: 600; color: #cbd5e1; font-size: 13px; }
  .group-meta { display: flex; align-items: center; gap: 8px; }
  .group-count {
    background: #1a3a6a; color: #60a5fa; border-radius: 20px;
    padding: 1px 10px; font-size: 12px; font-weight: 700;
  }
  .group-chevron { color: #334155; font-size: 10px; }
  .group-body { padding: 10px 12px; display: none; flex-wrap: wrap; }
  .group-body.open { display: flex; }

  /* Badges */
  .badge {
    background: #0d1a30; border: 1px solid #1e3a5a;
    color: #93c5fd; border-radius: 6px; padding: 3px 10px;
    font-size: 12px; display: inline-block; margin: 3px;
  }
  .badge.hidden-badge {
    background: #2a1a1a; border-color: #5a2a2a; color: #f87171;
  }

  /* Raw JSON */
  details { margin-top: 16px; }
  details summary {
    cursor: pointer; color: #334155; font-size: 11px;
    padding: 6px 0; user-select: none;
    text-transform: uppercase; letter-spacing: 0.08em;
  }
  details summary:hover { color: #475569; }
  details pre {
    background: #08080f; border: 1px solid #1a2a4a;
    border-radius: 10px; padding: 14px; font-size: 10px;
    color: #334155; overflow: auto; max-height: 300px; margin-top: 8px;
    font-family: monospace; line-height: 1.5;
  }

  /* Back link */
  .back-link {
    display: inline-flex; align-items: center; gap: 6px;
    color: #334155; font-size: 12px; text-decoration: none;
    margin-bottom: 20px; transition: color 0.2s;
  }
  .back-link:hover { color: #60a5fa; }

  @media (max-width: 480px) {
    .stat-card { min-width: calc(50% - 5px); }
    .search-bar { flex-direction: column; }
    .search-bar button { width: 100%; }
  }
</style>
</head>
<body>
<div class="container">

  <a href="https://admin.ultramax.vip" class="back-link">← Admin Dashboard</a>

  <div class="header">
    <div class="header-eyebrow">Ultra MAX Admin</div>
    <h1>Token Inspector</h1>
    <p>Full config breakdown for any installed user</p>
  </div>

  <div class="search-bar">
    <input type="text" id="tokenInput" placeholder="Paste user token  e.g. 12755046" />
    <button id="inspectBtn" onclick="inspect()">Inspect →</button>
  </div>

  <div id="error" class="error" style="display:none"></div>
  <div id="results" style="display:none"></div>

</div>

<script>
const ADMIN_SECRET = "9ba7b34f0a502c8af7e01073528bc4ff8ad1ed96b3e3cfdf";
const BASE_URL = "https://ultramax.vip/admin/inspect";

const CATALOG_GROUPS = {
  "🔥 Trending & Popular": ["trending_movies","trending_series","popular_movies","popular_series","top_movies","top_series","now_movies","airing_series","ontheair_series"],
  "📺 Streaming Services": ["netflix_movies","netflix_series","amazon_movies","amazon_series","disney_movies","disney_series","hbo_movies","hbo_series","apple_movies","apple_series","paramount_movies","paramount_series","peacock_movies","peacock_series","hulu_movies","hulu_series","discovery_movies","discovery_series"],
  "🎬 Genre Movies": ["action_movies","comedy_movies","horror_movies","scifi_movies","thriller_movies","crime_movies","drama_movies","romance_movies","mystery_movies","animation_movies","documentary_movies","fantasy_movies","adventure_movies","western_movies","family_movies"],
  "📡 Genre Series": ["action_series","comedy_series","horror_series","scifi_series","thriller_series","crime_series","drama_series","romance_series","mystery_series","animation_series","documentary_series","fantasy_series","adventure_series","family_series"],
  "🎭 Actors": [],
  "🎬 Directors": [],
  "🏢 Studios & Networks": [],
  "🎯 Themes": [],
  "📋 MDBList": [],
  "🌟 Collections": [],
  "🚀 Trakt": [],
  "🔍 Other": [],
};

const LABELS = {
  trending_movies:"Trending Movies",trending_series:"Trending Series",popular_movies:"Popular Movies",popular_series:"Popular Series",top_movies:"Top Rated Movies",top_series:"Top Rated Series",now_movies:"Now Playing",airing_series:"Currently Airing",ontheair_series:"On The Air",netflix_movies:"Netflix Movies",netflix_series:"Netflix Series",amazon_movies:"Amazon Movies",amazon_series:"Amazon Series",disney_movies:"Disney+ Movies",disney_series:"Disney+ Series",hbo_movies:"HBO Movies",hbo_series:"HBO Series",apple_movies:"Apple TV+ Movies",apple_series:"Apple TV+ Series",paramount_movies:"Paramount+ Movies",paramount_series:"Paramount+ Series",peacock_movies:"Peacock Movies",peacock_series:"Peacock Series",hulu_movies:"Hulu Movies",hulu_series:"Hulu Series",action_movies:"Action Movies",comedy_movies:"Comedy Movies",horror_movies:"Horror Movies",scifi_movies:"Sci-Fi Movies",thriller_movies:"Thriller Movies",crime_movies:"Crime Movies",drama_movies:"Drama Movies",romance_movies:"Romance Movies",mystery_movies:"Mystery Movies",animation_movies:"Animation Movies",documentary_movies:"Documentary Movies",fantasy_movies:"Fantasy Movies",adventure_movies:"Adventure Movies",family_movies:"Family Movies",action_series:"Action Series",comedy_series:"Comedy Series",horror_series:"Horror Series",scifi_series:"Sci-Fi Series",thriller_series:"Thriller Series",crime_series:"Crime Series",drama_series:"Drama Series",romance_series:"Romance Series",mystery_series:"Mystery Series",animation_series:"Animation Series",documentary_series:"Documentary Series",fantasy_series:"Fantasy Series",adventure_series:"Adventure Series",family_series:"Family Series",
};

function labelFor(id) {
  if (LABELS[id]) return LABELS[id];
  return id.replace(/_/g, " ").replace(/\b\w/g, c => c.toUpperCase());
}

function categorizeCatalogs(catalogs) {
  const groups = {};
  Object.keys(CATALOG_GROUPS).forEach(g => groups[g] = []);
  const staticKeys = Object.values(CATALOG_GROUPS).flat();
  catalogs.forEach(id => {
    if (staticKeys.includes(id)) {
      const g = Object.entries(CATALOG_GROUPS).find(([,ids]) => ids.includes(id));
      if (g) { groups[g[0]].push(id); return; }
    }
    if (id.startsWith("actor_")) groups["🎭 Actors"].push(id);
    else if (id.startsWith("director_")) groups["🎬 Directors"].push(id);
    else if (id.startsWith("studio_") || id.startsWith("network_")) groups["🏢 Studios & Networks"].push(id);
    else if (id.startsWith("theme_")) groups["🎯 Themes"].push(id);
    else if (id.startsWith("mdb_")) groups["📋 MDBList"].push(id);
    else if (id.startsWith("collection_") || id.startsWith("tmdb_collection")) groups["🌟 Collections"].push(id);
    else if (id.startsWith("trakt_")) groups["🚀 Trakt"].push(id);
    else groups["🔍 Other"].push(id);
  });
  return groups;
}

function timeAgo(dateStr) {
  if (!dateStr) return "Never";
  const diff = Date.now() - new Date(dateStr).getTime();
  const mins = Math.floor(diff / 60000);
  const hours = Math.floor(mins / 60);
  const days = Math.floor(hours / 24);
  if (days > 30) return new Date(dateStr).toLocaleDateString();
  if (days > 0) return `${days}d ago`;
  if (hours > 0) return `${hours}h ago`;
  if (mins > 0) return `${mins}m ago`;
  return "Just now";
}

function fmtDate(d) {
  if (!d) return "—";
  return new Date(d).toLocaleDateString("en-GB", { day:"numeric", month:"short", year:"numeric" });
}

function daysSince(d) {
  if (!d) return null;
  return Math.floor((Date.now() - new Date(d)) / 86400000);
}

function infoRow(label, value, cls = "") {
  if (value === null || value === undefined || value === "") return "";
  return `<div class="info-row">
    <span class="info-label">${label}</span>
    <span class="info-value ${cls}">${value}</span>
  </div>`;
}

function statCard(label, value, color, sub = "") {
  return `<div class="stat-card" style="border:1px solid ${color}44">
    <div class="stat-value" style="color:${color}">${value}</div>
    ${sub ? `<div class="stat-sub" style="color:${color}">${sub}</div>` : ""}
    <div class="stat-label">${label}</div>
  </div>`;
}

function toggleGroup(el) {
  const body = el.nextElementSibling;
  const chevron = el.querySelector(".group-chevron");
  body.classList.toggle("open");
  chevron.textContent = body.classList.contains("open") ? "▲" : "▼";
}

async function inspect() {
  const token = document.getElementById("tokenInput").value.trim();
  if (!token) return;

  const btn = document.getElementById("inspectBtn");
  const errEl = document.getElementById("error");
  const results = document.getElementById("results");

  btn.disabled = true;
  btn.textContent = "Loading…";
  errEl.style.display = "none";
  results.style.display = "none";

  try {
    const res = await fetch(`${BASE_URL}/${token}`, {
      headers: { "x-admin-secret": ADMIN_SECRET }
    });
    if (res.status === 401) throw new Error("Unauthorized — admin secret mismatch");
    if (res.status === 404) throw new Error("Token not found");
    if (!res.ok) throw new Error(`Server error ${res.status}`);
    const d = await res.json();
    render(d);
  } catch(e) {
    errEl.textContent = "⚠ " + e.message;
    errEl.style.display = "block";
  }

  btn.disabled = false;
  btn.textContent = "Inspect →";
}

function render(d) {
  const results = document.getElementById("results");
  const hiddenSet = new Set(d.hiddenCatalogs || []);
  const allCatalogs = [...(d.catalogs || []), ...(d.hiddenCatalogs || [])];
  const grouped = categorizeCatalogs(allCatalogs);
  const daysActive = daysSince(d.lastAccessed);
  const daysJoined = daysSince(d.createdAt);
  const activeColor = daysActive > 30 ? "#f59e0b" : daysActive > 14 ? "#fb923c" : "#34d399";
  const streamCount = (d.streamAddons || []).length;

  // Stat cards
  let html = `<div class="stat-row">
    ${statCard("Catalogs", d.catalogCount, "#3b82f6")}
    ${statCard("Hidden", d.hiddenCount, d.hiddenCount > 0 ? "#f87171" : "#334155")}
    ${statCard("Stream Addons", streamCount, "#8b5cf6")}
    ${statCard("Last Active", timeAgo(d.lastAccessed), activeColor)}
    ${statCard("Member", daysJoined !== null ? daysJoined + "d" : "—", "#06b6d4")}
  </div>`;

  // Config card
  html += `<div class="card">
    <div class="card-title">Configuration</div>
    ${infoRow("Token", d.token, "mono blue")}
    ${infoRow("Language", d.language || "—", "purple")}
    ${infoRow("MDBList Key", d.mdblistKey || "Not set", d.mdblistKey ? "mono" : "dim")}
    ${infoRow("RPDB Key", d.rpdbKey || "Not set", d.rpdbKey ? "mono" : "dim")}
    ${infoRow("TP Key", d.tpKey || "Not set", d.tpKey ? "mono" : "dim")}
    ${infoRow("Trakt User", d.traktUser || "Not linked", d.traktUser ? "orange" : "dim")}
    ${infoRow("Exclude Unreleased", d.excludeUnreleased ? "Yes" : "No")}
    ${infoRow("Max Rating", d.maxRating || "None", d.maxRating ? "" : "dim")}
    ${infoRow("Joined", fmtDate(d.createdAt))}
    ${infoRow("Last Updated", fmtDate(d.updatedAt))}
    ${infoRow("Last Accessed", `${fmtDate(d.lastAccessed)} &nbsp;<span style="color:${activeColor}">(${timeAgo(d.lastAccessed)})</span>`)}
  </div>`;

  // Stream addons
  if (streamCount > 0) {
    html += `<div class="card">
      <div class="card-title">Stream Addons <span style="color:#8b5cf6;margin-left:6px">${streamCount}</span></div>`;
    for (const url of d.streamAddons) {
      let host = url;
      try { host = new URL(url).hostname; } catch {}
      html += `<div class="stream-addon">
        <div class="stream-addon-host">${host}</div>
        <div class="stream-addon-url">${url}</div>
      </div>`;
    }
    html += `</div>`;
  }

  // Hidden notice
  if (d.hiddenCount > 0) {
    html += `<div class="hidden-notice">👁 ${d.hiddenCount} catalog${d.hiddenCount > 1 ? "s" : ""} installed but hidden from home — shown in red below</div>`;
  }

  // Catalog breakdown
  html += `<div class="section-label">Catalog Breakdown — ${d.catalogCount + d.hiddenCount} total</div>`;

  for (const [group, items] of Object.entries(grouped)) {
    if (items.length === 0) continue;
    const badges = items.map(id =>
      `<span class="badge${hiddenSet.has(id) ? " hidden-badge" : ""}">${hiddenSet.has(id) ? "👁 " : ""}${labelFor(id)}</span>`
    ).join("");
    html += `<div class="group">
      <div class="group-header" onclick="toggleGroup(this)">
        <span class="group-title">${group}</span>
        <span class="group-meta">
          <span class="group-count">${items.length}</span>
          <span class="group-chevron">▲</span>
        </span>
      </div>
      <div class="group-body open">${badges}</div>
    </div>`;
  }

  // Raw JSON
  html += `<details>
    <summary>Raw JSON</summary>
    <pre>${JSON.stringify(d, null, 2)}</pre>
  </details>`;

  results.innerHTML = html;
  results.style.display = "block";
}

// Enter key support
document.addEventListener("DOMContentLoaded", () => {
  document.getElementById("tokenInput").addEventListener("keydown", e => {
    if (e.key === "Enter") inspect();
  });
});
</script>
</body>
</html>
