<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Status — Ultra MAX</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg:#080810; --bg2:#0f0f1e; --card:#12121f; --border:#1e1e36; --border2:#2a2a45;
    --violet:#7B2FFF; --violet2:#9B5FFF;
    --green:#00d2a0; --red:#FF3D5A; --amber:#ffb800;
    --text:#e0e0f0; --muted:#7070a0;
  }
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
  body{background:var(--bg);color:var(--text);font-family:'Inter',sans-serif;min-height:100vh;}

  nav{display:flex;justify-content:space-between;align-items:center;padding:18px 32px;border-bottom:1px solid var(--border);background:rgba(8,8,16,0.92);backdrop-filter:blur(12px);position:sticky;top:0;z-index:100;}
  .logo{font-family:'Bebas Neue',sans-serif;font-size:1.4rem;letter-spacing:0.08em;color:#fff;text-decoration:none;}
  .logo span{color:var(--violet2);}
  .nav-back{font-size:13px;color:var(--muted);text-decoration:none;transition:color .2s;}
  .nav-back:hover{color:var(--text);}

  .hero{text-align:center;padding:48px 24px 32px;max-width:680px;margin:0 auto;}
  .hero-badge{display:inline-block;font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;padding:6px 14px;border-radius:100px;margin-bottom:18px;}
  .badge-operational{background:rgba(0,210,160,.1);border:1px solid rgba(0,210,160,.25);color:var(--green);}
  .badge-degraded{background:rgba(255,184,0,.1);border:1px solid rgba(255,184,0,.25);color:var(--amber);}
  .badge-outage{background:rgba(255,61,90,.1);border:1px solid rgba(255,61,90,.25);color:var(--red);}
  .hero h1{font-family:'Bebas Neue',sans-serif;font-size:clamp(2.5rem,7vw,4rem);letter-spacing:.04em;line-height:1;margin-bottom:10px;color:#fff;}
  .hero p{font-size:14px;color:var(--muted);line-height:1.7;}
  .last-checked{font-size:12px;color:var(--muted);margin-top:8px;}

  .main{max-width:780px;margin:0 auto;padding:28px 24px 80px;}

  .section-label{font-size:10px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);margin-bottom:12px;margin-top:28px;display:flex;align-items:center;gap:10px;}
  .section-label::after{content:'';flex:1;height:1px;background:var(--border);}

  .service-list{display:flex;flex-direction:column;gap:8px;}

  .service-item{background:var(--card);border:1px solid var(--border2);border-radius:12px;padding:14px 18px;display:flex;align-items:center;gap:14px;transition:border-color .2s;}
  .service-item:hover{border-color:var(--border2);}

  .service-status{width:10px;height:10px;border-radius:50%;flex-shrink:0;}
  .status-checking{background:var(--border2);animation:pulse 1.2s infinite;}
  .status-up{background:var(--green);box-shadow:0 0 8px rgba(0,210,160,.4);}
  .status-down{background:var(--red);box-shadow:0 0 8px rgba(255,61,90,.4);}
  .status-slow{background:var(--amber);box-shadow:0 0 8px rgba(255,184,0,.4);}

  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}

  .service-icon{font-size:1.2rem;flex-shrink:0;}
  .service-info{flex:1;min-width:0;}
  .service-name{font-weight:600;font-size:14px;color:var(--text);}
  .service-desc{font-size:11px;color:var(--muted);margin-top:2px;}
  .service-latency{font-size:11px;font-weight:600;flex-shrink:0;}
  .latency-fast{color:var(--green);}
  .latency-slow{color:var(--amber);}
  .latency-down{color:var(--red);}
  .latency-checking{color:var(--muted);}

  .overall-bar{background:var(--card);border:1px solid var(--border2);border-radius:14px;padding:20px 24px;margin-bottom:8px;display:flex;align-items:center;gap:16px;}
  .overall-icon{font-size:2rem;}
  .overall-text{flex:1;}
  .overall-title{font-weight:700;font-size:16px;color:var(--text);}
  .overall-sub{font-size:12px;color:var(--muted);margin-top:3px;}

  .refresh-btn{background:transparent;border:1px solid var(--border2);color:var(--muted);font-family:'Inter',sans-serif;font-size:12px;font-weight:600;padding:8px 16px;border-radius:8px;cursor:pointer;transition:all .15s;}
  .refresh-btn:hover{border-color:var(--violet2);color:var(--violet2);}

  @media(max-width:600px){
    nav{padding:14px 16px;}
    .hero{padding:32px 16px 20px;}
    .main{padding:16px 14px 60px;}
  }
</style>
<script defer src="https://umami-maxbase.duckdns.org/script.js" data-website-id="57e5e9f9-98bb-46cb-bd46-9b2a299e1af3"></script>
</head>
<body>

<nav>
  <a href="/" class="logo">ULTRA <span>MAX</span></a>
  <a href="/" class="nav-back">← Back to home</a>
</nav>

<div class="hero">
  <div class="hero-badge badge-operational" id="overallBadge">⬤ Checking...</div>
  <h1>System Status</h1>
  <p>Live status of all Ultra MAX services.</p>
  <div class="last-checked" id="lastChecked">Checking now...</div>
</div>

<div class="main">

  <div class="overall-bar">
    <div class="overall-icon" id="overallIcon">⏳</div>
    <div class="overall-text">
      <div class="overall-title" id="overallTitle">Checking all systems...</div>
      <div class="overall-sub" id="overallSub">Please wait while we ping all services.</div>
    </div>
    <button class="refresh-btn" onclick="runChecks()">↺ Refresh</button>
  </div>

  <div class="section-label">Core Services</div>
  <div class="service-list" id="coreList"></div>

  <div class="section-label">Streaming</div>
  <div class="service-list" id="streamList"></div>

  <div class="section-label">Infrastructure</div>
  <div class="service-list" id="infraList"></div>

</div>

<script>
const SERVICES = {
  core: [
    { name: 'Ultra MAX', desc: 'Main landing page', icon: '🚀', url: 'https://ultramax.vip/manifest.json' },
    { name: 'Setup Page', desc: 'Configure wizard', icon: '⚙️', url: 'https://ultramax.vip/setup.html' },
    { name: 'Quick Install', desc: 'Nuvio collections', icon: '⚡', url: 'https://ultramax.vip/quick.html' },
    { name: 'Ultra MAX TV', desc: 'Live TV addon', icon: '📺', url: 'https://tv.ultramax.vip/manifest.json' },
    { name: 'MaxMusic', desc: 'Music discovery addon', icon: '🎵', url: 'https://ultramax.vip/music.html' },
  ],
  stream: [
    { name: 'AIOStreams', desc: 'Stream aggregator', icon: '🌊', url: 'https://aio.ultramax.vip' },
    { name: 'Comet', desc: 'Debrid stream addon', icon: '☄️', url: 'https://comet.maxbase.kozow.com/manifest.json' },
    { name: 'MediaFlow', desc: 'Media proxy', icon: '📡', url: 'https://mediaflow.maxbase.kozow.com' },
    { name: 'StremThru', desc: 'Debrid proxy', icon: '🔀', url: 'https://stremthru.maxbase.kozow.com' },
    { name: 'Zilean', desc: 'Torrent index', icon: '⏱', url: 'https://zilean.maxbase.kozow.com/healthz' },
  ],
  infra: [
    { name: 'Nginx Proxy', desc: 'Reverse proxy & SSL', icon: '🔒', url: 'https://ultramax.vip' },
    { name: 'Jackett', desc: 'Torrent indexer', icon: '🔍', url: 'https://jackett.maxbase.kozow.com' },
    { name: 'Webstreamr', desc: 'Stream sources', icon: '📻', url: 'https://webstreamr.maxbase.kozow.com' },
  ]
};

function renderList(listId, services){
  const el = document.getElementById(listId);
  el.innerHTML = services.map((s, i) => `
    <div class="service-item" id="svc-${listId}-${i}">
      <div class="service-status status-checking" id="dot-${listId}-${i}"></div>
      <div class="service-icon">${s.icon}</div>
      <div class="service-info">
        <div class="service-name">${s.name}</div>
        <div class="service-desc">${s.desc}</div>
      </div>
      <div class="service-latency latency-checking" id="lat-${listId}-${i}">—</div>
    </div>
  `).join('');
}

async function checkService(listId, i, url){
  const dot = document.getElementById(`dot-${listId}-${i}`);
  const lat = document.getElementById(`lat-${listId}-${i}`);
  const start = Date.now();
  try {
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 8000);
    await fetch(url, { method: 'HEAD', mode: 'no-cors', signal: controller.signal });
    clearTimeout(timeout);
    const ms = Date.now() - start;
    dot.className = 'service-status ' + (ms > 2000 ? 'status-slow' : 'status-up');
    lat.textContent = ms + 'ms';
    lat.className = 'service-latency ' + (ms > 2000 ? 'latency-slow' : 'latency-fast');
    return { ok: true, ms };
  } catch(e) {
    const ms = Date.now() - start;
    dot.className = 'service-status status-down';
    lat.textContent = 'Down';
    lat.className = 'service-latency latency-down';
    return { ok: false, ms };
  }
}

async function runChecks(){
  // Render lists
  renderList('coreList', SERVICES.core);
  renderList('streamList', SERVICES.stream);
  renderList('infraList', SERVICES.infra);

  document.getElementById('overallBadge').className = 'hero-badge badge-degraded';
  document.getElementById('overallBadge').textContent = '⬤ Checking...';
  document.getElementById('overallIcon').textContent = '⏳';
  document.getElementById('overallTitle').textContent = 'Checking all systems...';
  document.getElementById('overallSub').textContent = 'Please wait while we ping all services.';

  const allServices = [
    ...SERVICES.core.map((s,i) => checkService('coreList', i, s.url)),
    ...SERVICES.stream.map((s,i) => checkService('streamList', i, s.url)),
    ...SERVICES.infra.map((s,i) => checkService('infraList', i, s.url)),
  ];

  const results = await Promise.all(allServices);
  const upCount = results.filter(r => r.ok).length;
  const total = results.length;
  const allUp = upCount === total;
  const mostUp = upCount >= total * 0.8;

  const badge = document.getElementById('overallBadge');
  const icon = document.getElementById('overallIcon');
  const title = document.getElementById('overallTitle');
  const sub = document.getElementById('overallSub');

  if(allUp){
    badge.className = 'hero-badge badge-operational';
    badge.textContent = '⬤ All Systems Operational';
    icon.textContent = '✅';
    title.textContent = 'All systems operational';
    sub.textContent = `${total}/${total} services running normally.`;
  } else if(mostUp){
    badge.className = 'hero-badge badge-degraded';
    badge.textContent = '⬤ Partial Degradation';
    icon.textContent = '⚠️';
    title.textContent = 'Minor issues detected';
    sub.textContent = `${upCount}/${total} services running normally.`;
  } else {
    badge.className = 'hero-badge badge-outage';
    badge.textContent = '⬤ Service Disruption';
    icon.textContent = '🚨';
    title.textContent = 'Service disruption detected';
    sub.textContent = `${upCount}/${total} services running normally.`;
  }

  const now = new Date();
  document.getElementById('lastChecked').textContent = 
    'Last checked: ' + now.toLocaleTimeString();
}

// Run on load
runChecks();
// Auto-refresh every 60 seconds
setInterval(runChecks, 60000);
</script>

</body>
</html>
