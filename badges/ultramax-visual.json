{
  "filters": [
    {
      "id": "r-4k",
      "name": "4K",
      "type": "filter",
      "isEnabled": true,
      "imageURL": "https://ultramax.vip/badges/4k.webp",
      "pattern": "(?i)^(?=.*(?:2160[pi]?|4k|uhd))(?!.*(?:1080[pi]?|720[pi]?))",
      "tagColor": "#00000000",
      "tagStyle": "filled and bordered",
      "textColor": "#FFFFFF",
      "borderColor": "#FF858283"
    },
    {
      "id": "r-1080",
      "name": "1080p",
      "type": "filter",
      "isEnabled": true,
      "imageURL": "https://ultramax.vip/badges/1080p.webp",
      "pattern": "(?i)\\b1080[pi]?\\b",
      "tagColor": "#00000000",
      "tagStyle": "filled and bordered",
      "textColor": "#FFFFFF",
      "borderColor": "#FF858283"
    },
    {
      "id": "v-dv",
      "name": "Dolby Vision",
      "type": "filter",
      "isEnabled": true,
      "imageURL": "https://ultramax.vip/badges/dolby-vision.webp",
      "pattern": "(?i)(?:^|(?:[._\\-/]|\\s))(?:dv|dovi|dolby[\\s._-]?vision)(?:(?:[._\\-/]|\\s)|$)",
      "tagColor": "#00000000",
      "tagStyle": "filled and bordered",
      "textColor": "#FFFFFF",
      "borderColor": "#FFFF9800"
    },
    {
      "id": "v-hdr10p",
      "name": "HDR10+",
      "type": "filter",
      "isEnabled": true,
      "imageURL": "https://ultramax.vip/badges/hdr10plus.webp",
      "pattern": "(?i)hdr[\\s._-]?10[\\s._-]?(?:\\+|plus|p(?:lus)?)",
      "tagColor": "#00000000",
      "tagStyle": "filled and bordered",
      "textColor": "#FFFFFF",
      "borderColor": "#FFFF9800"
    },
    {
      "id": "v-hdr10",
      "name": "HDR10",
      "type": "filter",
      "isEnabled": true,
      "imageURL": "https://ultramax.vip/badges/hdr10.webp",
      "pattern": "(?i)(?:^(?!.*\\b(?:dv|dovi|dolby[\\s._-]?vision)\\b)(?=.*hdr[\\s._-]?10)(?!.*hdr[\\s._-]?10[\\s._-]?(?:\\+|plus|p(?:lus)?)))",
      "tagColor": "#00000000",
      "tagStyle": "filled and bordered",
      "textColor": "#FFFFFF",
      "borderColor": "#FFFF9800"
    },
    {
      "id": "v-hdr",
      "name": "HDR",
      "type": "filter",
      "isEnabled": true,
      "imageURL": "https://ultramax.vip/badges/hdr.webp",
      "pattern": "(?i)(?:^(?!.*\\b(?:dv|dovi|dolby[\\s._-]?vision)\\b)(?=.*\\b(?:HDR|HLG|PQ)\\b)(?!.*hdr[\\s._-]?10))",
      "tagColor": "#00000000",
      "tagStyle": "filled and bordered",
      "textColor": "#FFFFFF",
      "borderColor": "#FFFF9800"
    },
    {
      "id": "v-imax-e",
      "name": "IMAX Enhanced",
      "type": "filter",
      "isEnabled": true,
      "imageURL": "https://ultramax.vip/badges/imax-enhanced.webp",
      "pattern": "(?i)(?:\\bimax[\\s._-]?enhanced\\b|^(?=.*\\b(?:dsnp|ds\\+|disney\\+|bcore|bc)\\b)(?=.*\\bweb[\\s._-]?(?:dl|rip)\\b)(?=.*\\b(?<!non[\\s._-])imax\\b))",
      "tagColor": "#00000000",
      "tagStyle": "filled and bordered",
      "textColor": "#FFFFFF",
      "borderColor": "#FFFF9800"
    },
    {
      "id": "v-hevc",
      "name": "HEVC",
      "type": "filter",
      "isEnabled": true,
      "imageURL": "https://ultramax.vip/badges/hevc.webp",
      "pattern": "(?i)\\b(?:hevc|x265|h\\.?265)\\b",
      "tagColor": "#00000000",
      "tagStyle": "filled and bordered",
      "textColor": "#FFFFFF",
      "borderColor": "#FF858283"
    },
    {
      "id": "a-atmos",
      "name": "Dolby Atmos",
      "type": "filter",
      "isEnabled": true,
      "imageURL": "https://ultramax.vip/badges/dolby-atmos.webp",
      "pattern": "(?i)(?:^|(?:[._\\-/]|\\s))atmos(?:(?:[._\\-/]|\\s)|$)",
      "tagColor": "#00000000",
      "tagStyle": "filled and bordered",
      "textColor": "#FFFFFF",
      "borderColor": "#FF00BCD4"
    },
    {
      "id": "a-truehd",
      "name": "Dolby TrueHD",
      "type": "filter",
      "isEnabled": true,
      "imageURL": "https://ultramax.vip/badges/dolby-truehd.webp",
      "pattern": "(?i)(?:^|(?:[._\\-/]|\\s))truehd(?:(?:[._\\-/]|\\s)|$)|\\btrue[\\s._-]?hd\\b",
      "tagColor": "#00000000",
      "tagStyle": "filled and bordered",
      "textColor": "#FFFFFF",
      "borderColor": "#FF00BCD4"
    },
    {
      "id": "a-dd",
      "name": "Dolby Digital",
      "type": "filter",
      "isEnabled": true,
      "imageURL": "https://ultramax.vip/badges/dolby-digital.webp",
      "pattern": "(?i)^(?=.*(?:(?:^|(?:[._\\-/]|\\s))dd[25](?:[.\\s][01]|\\s[01])|(?:^|(?:[._\\-/]|\\s))ac3(?:(?:[._\\-/]|\\s)|$)))(?!.*(?:(?:^|(?:[._\\-/]|\\s))ddp|dd\\+|eac3|digital\\+|dolby[\\s._-]digital[\\s._-]plus))(?!.*truehd)(?!.*atmos)",
      "tagColor": "#00000000",
      "tagStyle": "filled and bordered",
      "textColor": "#FFFFFF",
      "borderColor": "#FF00BCD4"
    },
    {
      "id": "a-dtsx",
      "name": "DTS:X",
      "type": "filter",
      "isEnabled": true,
      "imageURL": "https://ultramax.vip/badges/dts-x.webp",
      "pattern": "(?i)\\bdts[-_.: ]?x\\b",
      "tagColor": "#00000000",
      "tagStyle": "filled and bordered",
      "textColor": "#FFFFFF",
      "borderColor": "#FF00BCD4"
    },
    {
      "id": "a-dtshdma",
      "name": "DTS-HD MA",
      "type": "filter",
      "isEnabled": true,
      "imageURL": "https://ultramax.vip/badges/dts-hd-ma.webp",
      "pattern": "(?i)^(?=.*\\bdts[-_. ]?(?:hd[-_. ]?)?ma\\b)(?!.*\\bdts[-_.: ]?x\\b)",
      "tagColor": "#00000000",
      "tagStyle": "filled and bordered",
      "textColor": "#FFFFFF",
      "borderColor": "#FF00BCD4"
    },
    {
      "id": "ch-71",
      "name": "7.1",
      "type": "filter",
      "isEnabled": true,
      "imageURL": "https://ultramax.vip/badges/7dot1.webp",
      "pattern": "[^0-9][7-8][. ][01](?![0-9])",
      "tagColor": "#00000000",
      "tagStyle": "filled and bordered",
      "textColor": "#FFFFFF",
      "borderColor": "#FF858283"
    },
    {
      "id": "ch-51",
      "name": "5.1",
      "type": "filter",
      "isEnabled": true,
      "imageURL": "https://ultramax.vip/badges/5dot1.webp",
      "pattern": "^(?=.*[^0-9]5[. ][01](?![0-9]))(?!.*[^0-9][7-8][. ][01](?![0-9]))",
      "tagColor": "#00000000",
      "tagStyle": "filled and bordered",
      "textColor": "#FFFFFF",
      "borderColor": "#FF858283"
    }
  ]
}
