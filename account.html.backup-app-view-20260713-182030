<!-- ULTRAMAX ANDROID BACK START -->

<style>
#umBackToast {
  display: none;
  position: fixed;
  left: 50%;
  bottom: calc(92px + env(safe-area-inset-bottom));
  z-index: 100050;
  transform: translateX(-50%) translateY(12px);
  width: max-content;
  max-width: calc(100% - 40px);
  padding: 11px 18px;
  border: 1px solid rgba(155,95,255,.32);
  border-radius: 999px;
  background: rgba(14,12,28,.96);
  color: #fff;
  box-shadow: 0 14px 40px rgba(0,0,0,.45);
  font-family: Inter, Arial, sans-serif;
  font-size: 13px;
  font-weight: 700;
  text-align: center;
  opacity: 0;
  transition: opacity .2s ease, transform .2s ease;
  pointer-events: none;
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}

html.native-app #umBackToast.show {
  display: block;
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}
</style>

<div id="umBackToast" role="status" aria-live="polite">
  Press back again to exit
</div>

<script>
(function () {
  var params = new URLSearchParams(window.location.search);

  if (params.get('native') !== '1') return;

  var lastBackPress = 0;
  var toastTimer = null;

  function currentPage() {
    var page = window.location.pathname.split('/').pop();
    return page || 'app.html';
  }

  function isHomePage() {
    return currentPage() === 'app.html';
  }

  function showExitToast() {
    var toast = document.getElementById('umBackToast');
    if (!toast) return;

    toast.classList.add('show');

    clearTimeout(toastTimer);

    toastTimer = setTimeout(function () {
      toast.classList.remove('show');
    }, 1900);
  }

  function goHome() {
    window.location.href =
      '/app.html?native=1&fromBack=1';
  }

  function closeOpenOverlay() {
    /*
      Handles common visible dialogs, menus and overlays before navigating.
      It safely does nothing when none are open.
    */
    var selectors = [
      '[role="dialog"].open',
      '[role="dialog"].show',
      '.modal.open',
      '.modal.show',
      '.modal.active',
      '.overlay.open',
      '.overlay.show',
      '.drawer.open',
      '.drawer.show',
      '.menu.open'
    ];

    var openElement = document.querySelector(selectors.join(','));

    if (!openElement) return false;

    var closeButton = openElement.querySelector(
      '[data-close], .close, .modal-close, .close-button, button[aria-label="Close"]'
    );

    if (closeButton) {
      closeButton.click();
    } else {
      openElement.classList.remove('open', 'show', 'active');
    }

    return true;
  }

  function installBackHandler() {
    var AppPlugin =
      window.Capacitor &&
      window.Capacitor.Plugins &&
      window.Capacitor.Plugins.App;

    if (!AppPlugin || typeof AppPlugin.addListener !== 'function') {
      console.warn('Ultra MAX: Capacitor App plugin unavailable');
      return;
    }

    AppPlugin.addListener('backButton', function (event) {
      if (closeOpenOverlay()) return;

      if (!isHomePage()) {
        var sameOriginReferrer = false;

        try {
          sameOriginReferrer =
            !!document.referrer &&
            new URL(document.referrer).origin === window.location.origin;
        } catch (error) {}

        if (event.canGoBack && sameOriginReferrer) {
          window.history.back();
        } else {
          goHome();
        }

        return;
      }

      var now = Date.now();

      if (now - lastBackPress < 2000) {
        AppPlugin.exitApp();
        return;
      }

      lastBackPress = now;
      showExitToast();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', installBackHandler);
  } else {
    installBackHandler();
  }
})();
</script>

<!-- ULTRAMAX ANDROID BACK END -->

