<script src="/nuvio-push.js"></script>
<script>
(function(){
  const params = new URLSearchParams(window.location.search);
  const setupToken = params.get('token');
  if (setupToken) {
    document.getElementById('backLink').href = '/configure/' + setupToken;
  }

  const loginStage = document.getElementById('loginStage');
  const profilePickStage = document.getElementById('profilePickStage');
  const managerStage = document.getElementById('managerStage');
  const loginStatus = loginStage.querySelector('.status');
  const pickStatus = profilePickStage.querySelector('.status');
  const managerStatus = document.getElementById('managerStatus');
  const profileList = document.getElementById('profileList');
  const addonList = document.getElementById('addonList');
  const collectionList = document.getElementById('collectionList');

  let accessToken = null;
  let profiles = [];
  let selectedProfile = null;
  let currentAddons = [];
  let currentCollections = [];

  (async function init(){
    const restored = await nuvioTryRestoreSession().catch(() => null);
    if (restored) {
      accessToken = restored.accessToken;
      profiles = restored.profiles;
      loginStage.classList.add('hidden');
      showProfilePicker();
    }
  })();

  function renderProfileList(container, onSelect){
    container.innerHTML = '';
    profiles.forEach(function(p){
      const row = document.createElement('div');
      row.className = 'profile-row';

      const avatar = document.createElement('div');
      avatar.className = 'avatar';
      if (p.avatar_url) {
        const img = document.createElement('img');
        img.src = p.avatar_url;
        img.onerror = function(){
          avatar.textContent = (p.name || '?').charAt(0).toUpperCase();
          avatar.style.background = p.avatar_color_hex || '#7B2FFF';
          img.remove();
        };
        avatar.appendChild(img);
      } else {
        avatar.textContent = (p.name || '?').charAt(0).toUpperCase();
        avatar.style.background = p.avatar_color_hex || '#7B2FFF';
      }

      const name = document.createElement('div');
      name.className = 'profile-name';
      name.textContent = p.name;

      row.appendChild(avatar);
      row.appendChild(name);
      row.addEventListener('click', function(){ onSelect(p); });
      container.appendChild(row);
    });
  }

  function showProfilePicker(){
    profilePickStage.classList.remove('hidden');
    renderProfileList(profileList, selectProfile);
  }

  async function selectProfile(p){
    selectedProfile = p;
    profilePickStage.classList.add('hidden');
    managerStage.classList.remove('hidden');

    const activeAvatar = document.getElementById('activeAvatar');
    activeAvatar.innerHTML = '';
    if (p.avatar_url) {
      const img = document.createElement('img');
      img.src = p.avatar_url;
      img.onerror = function(){
        activeAvatar.textContent = (p.name || '?').charAt(0).toUpperCase();
        activeAvatar.style.background = p.avatar_color_hex || '#7B2FFF';
        img.remove();
      };
      activeAvatar.appendChild(img);
    } else {
      activeAvatar.textContent = (p.name || '?').charAt(0).toUpperCase();
      activeAvatar.style.background = p.avatar_color_hex || '#7B2FFF';
    }
    document.getElementById('activeName').textContent = p.name;

    managerStatus.textContent = 'Loading...';
    managerStatus.style.color = 'var(--muted)';

    try {
      currentAddons = await nuvioGetAddons(accessToken, p.profile_index);
      currentCollections = await nuvioGetCollections(accessToken, p.profile_index);
      renderAddons();
      renderCollections();
      managerStatus.textContent = '';
    } catch (err) {
      managerStatus.textContent = err.message || 'Failed to load profile data.';
      managerStatus.style.color = 'var(--err)';
    }
  }
  function renderAddons(){
    document.getElementById('addonCount').textContent = currentAddons.length + ' installed';
    addonList.innerHTML = '';
    if (currentAddons.length === 0) {
      addonList.innerHTML = '<div class="empty-note">No addons installed on this profile.</div>';
      return;
    }
    currentAddons.forEach(function(addon, idx){
      const row = document.createElement('div');
      row.className = 'item-row';
      row.innerHTML =
        '<div style="flex:1;min-width:0;">' +
          '<div class="item-name">' + escapeHtml(addon.name || 'Unnamed addon') + '</div>' +
          '<div class="item-sub">' + escapeHtml(addon.url || '') + '</div>' +
        '</div>';
      const reorderStyle = 'background:rgba(255,255,255,.06);border:1px solid var(--border2);color:var(--text);border-radius:6px;width:26px;height:26px;flex-shrink:0;cursor:pointer;font-size:12px;';
      const upBtn = document.createElement('button');
      upBtn.style.cssText = reorderStyle;
      upBtn.textContent = '↑';
      upBtn.disabled = (idx === 0);
      upBtn.style.opacity = (idx === 0) ? '0.3' : '1';
      upBtn.addEventListener('click', function(){
        if (idx === 0) return;
        const tmp = currentAddons[idx - 1];
        currentAddons[idx - 1] = currentAddons[idx];
        currentAddons[idx] = tmp;
        renderAddons();
      });
      const downBtn = document.createElement('button');
      downBtn.style.cssText = reorderStyle;
      downBtn.textContent = '↓';
      downBtn.disabled = (idx === currentAddons.length - 1);
      downBtn.style.opacity = (idx === currentAddons.length - 1) ? '0.3' : '1';
      downBtn.addEventListener('click', function(){
        if (idx === currentAddons.length - 1) return;
        const tmp = currentAddons[idx + 1];
        currentAddons[idx + 1] = currentAddons[idx];
        currentAddons[idx] = tmp;
        renderAddons();
      });
      const removeBtn = document.createElement('button');
      removeBtn.className = 'remove-btn';
      removeBtn.textContent = '✕';
      removeBtn.addEventListener('click', function(){
        currentAddons.splice(idx, 1);
        renderAddons();
      });
      row.appendChild(upBtn);
      row.appendChild(downBtn);
      row.appendChild(removeBtn);
      addonList.appendChild(row);
    });
  }


  function renderCollections(){
    document.getElementById('collectionCount').textContent = currentCollections.length + ' collections';
    collectionList.innerHTML = '';
    if (currentCollections.length === 0) {
      collectionList.innerHTML = '<div class="empty-note">No collections on this profile.</div>';
      return;
    }
    currentCollections.forEach(function(coll, idx){
      const row = document.createElement('div');
      row.className = 'item-row';
      const folderCount = Array.isArray(coll.folders) ? coll.folders.length : 0;
      row.innerHTML =
        '<div style="flex:1;min-width:0;">' +
          '<div class="item-name">' + escapeHtml(coll.title || 'Untitled collection') + '</div>' +
          '<div class="item-sub">' + folderCount + ' folder' + (folderCount === 1 ? '' : 's') + '</div>' +
        '</div>';
      const removeBtn = document.createElement('button');
      removeBtn.className = 'remove-btn';
      removeBtn.textContent = '✕';
      removeBtn.addEventListener('click', function(){
        currentCollections.splice(idx, 1);
        renderCollections();
      });
      row.appendChild(removeBtn);
      collectionList.appendChild(row);
    });
  }

  function escapeHtml(str){
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  document.getElementById('loginBtn').addEventListener('click', async () => {
    const email = document.getElementById('email').value.trim();
    const password = document.getElementById('password').value;
    const remember = document.getElementById('rememberMe').checked;
    const btn = document.getElementById('loginBtn');

    if (!email || !password) {
      loginStatus.textContent = 'Please enter your Nuvio email and password.';
      loginStatus.style.color = 'var(--err)';
      return;
    }

    btn.disabled = true;
    loginStatus.style.color = 'var(--muted)';
    loginStatus.textContent = 'Logging in...';

    try {
      const result = await nuvioLoginAndListProfiles(email, password);
      accessToken = result.accessToken;
      profiles = result.profiles;
      document.getElementById('password').value = '';

      if (remember) {
        nuvioSaveSession(result.refreshToken);
      }

      loginStage.classList.add('hidden');
      showProfilePicker();
    } catch (err) {
      loginStatus.textContent = err.message || 'Login failed.';
      loginStatus.style.color = 'var(--err)';
    } finally {
      btn.disabled = false;
    }
  });

  document.getElementById('switchBtn').addEventListener('click', () => {
    managerStage.classList.add('hidden');
    showProfilePicker();
  });

  document.getElementById('addAddonBtn').addEventListener('click', async () => {
    const input = document.getElementById('newAddonUrl');
    const statusEl = document.getElementById('addAddonStatus');
    const url = input.value.trim();
    if (!url) { statusEl.textContent = 'Please paste a manifest URL.'; statusEl.style.color = 'var(--err)'; return; }
    if (currentAddons.some(a => a.url === url)) { statusEl.textContent = 'That addon is already in the list.'; statusEl.style.color = 'var(--err)'; return; }
    statusEl.textContent = 'Checking addon...';
    statusEl.style.color = 'var(--muted)';
    let addonName = url;
    try {
      const manifestUrl = url.endsWith('.json') ? url : url.replace(/\/$/, '') + '/manifest.json';
      const resp = await fetch(manifestUrl);
      if (resp.ok) {
        const manifest = await resp.json();
        if (manifest && manifest.name) addonName = manifest.name;
      }
    } catch (e) { /* fall back to using the URL as the name */ }
    currentAddons.push({ url: url, name: addonName, enabled: true });
    renderAddons();
    input.value = '';
    statusEl.textContent = 'Added "' + addonName + '" — click Save below to push it to Nuvio.';
    statusEl.style.color = 'var(--ok)';
  });

  document.getElementById('saveBtn').addEventListener('click', async () => {
    const btn = document.getElementById('saveBtn');
    btn.disabled = true;
    managerStatus.style.color = 'var(--muted)';
    managerStatus.textContent = 'Saving addons...';

    try {
      await nuvioPushAddons(accessToken, selectedProfile.profile_index, currentAddons);
      managerStatus.textContent = 'Saving collections...';
      await nuvioPushCollections(accessToken, selectedProfile.profile_index, currentCollections);
      managerStatus.textContent = 'Saved ✓';
      managerStatus.style.color = 'var(--ok)';
    } catch (err) {
      managerStatus.textContent = err.message || 'Failed to save changes.';
      managerStatus.style.color = 'var(--err)';
    } finally {
      btn.disabled = false;
    }
  });
})();
</script>

