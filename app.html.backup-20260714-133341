<script>
(async function checkForAppUpdateModal() {
  try {
    var params = new URLSearchParams(location.search);

    var isNative =
      params.get('native') === '1' ||
      (
        window.Capacitor &&
        typeof window.Capacitor.isNativePlatform === 'function' &&
        window.Capacitor.isNativePlatform()
      );

    if (!isNative) return;

    var AppPlugin =
      window.Capacitor &&
      window.Capacitor.Plugins &&
      window.Capacitor.Plugins.App;

    var currentBuild = 0;

    if (AppPlugin) {
      var info = await AppPlugin.getInfo();

      currentBuild =
        parseInt(info.build, 10) || 0;
    }

    if (!currentBuild) {
      currentBuild =
        parseInt(window.ultraMaxInstalledBuild, 10) || 0;
    }

    if (!currentBuild) {
      var paramsBuild =
        new URLSearchParams(location.search)
          .get('appbuild');

      currentBuild =
        parseInt(paramsBuild, 10) || 0;
    }

    if (!currentBuild) {
      try {
        currentBuild =
          parseInt(
            sessionStorage.getItem(
              'ultramax_installed_build'
            ),
            10
          ) || 0;
      } catch (error) {}
    }

    if (!currentBuild) return;

    var response = await fetch(
      '/app-version.json?fresh=' + Date.now(),
      { cache: 'no-store' }
    );

    if (!response.ok) return;

    var data = await response.json();

    var latestBuild =
      parseInt(data.latestVersionCode, 10) || 0;

    if (!latestBuild || latestBuild <= currentBuild) return;

    var dismissedBuild = null;

    try {
      dismissedBuild =
        sessionStorage.getItem(
          'ultramax_update_dismissed_build'
        );
    } catch (error) {}

    if (String(latestBuild) === dismissedBuild) return;

    var overlay =
      document.getElementById('umUpdateOverlay');

    var version =
      document.getElementById('umUpdateVersion');

    var notes =
      document.getElementById('umUpdateNotes');

    var updateButton =
      document.getElementById('umUpdateNow');

    var laterButton =
      document.getElementById('umUpdateLater');

    if (!overlay) return;

    version.textContent =
      'Version ' +
      (data.latestVersionName || latestBuild) +
      ' · Build ' +
      latestBuild;

    notes.textContent =
      data.notes ||
      'A newer version of Ultra MAX is available.';

    function closeModal() {
      overlay.classList.remove('open');

      try {
        sessionStorage.setItem(
          'ultramax_update_dismissed_build',
          String(latestBuild)
        );
      } catch (error) {}
    }

    laterButton.addEventListener(
      'click',
      closeModal
    );

    overlay.addEventListener(
      'click',
      function (event) {
        if (event.target === overlay) {
          closeModal();
        }
      }
    );

    updateButton.addEventListener(
      'click',
      function () {
        if (!data.downloadUrl) return;

        window.location.href = data.downloadUrl;
      }
    );

    requestAnimationFrame(function () {
      overlay.classList.add('open');
    });
  } catch (error) {
    console.warn(
      'Ultra MAX update check failed:',
      error
    );
  }
})();
</script>

<!-- ULTRAMAX UPDATE MODAL END -->


<script>
(function () {
  async function updateDevBuildBadge() {
    var versionElement =
      document.getElementById('devBadgeVersion');

    var buildElement =
      document.getElementById('devBadgeBuild');

    if (!versionElement || !buildElement) return;

    var versionName = '';
    var buildCode = 0;

    try {
      var AppPlugin =
        window.Capacitor &&
        window.Capacitor.Plugins &&
        window.Capacitor.Plugins.App;

      if (AppPlugin) {
        var info = await AppPlugin.getInfo();

        versionName = info.version || '';
        buildCode = parseInt(info.build, 10) || 0;
      }
    } catch (error) {
      console.warn(
        'Could not read native Dev version:',
        error
      );
    }

    if (!buildCode) {
      buildCode =
        parseInt(window.ultraMaxInstalledBuild, 10) || 0;
    }

    if (!buildCode) {
      buildCode =
        parseInt(
          new URLSearchParams(location.search)
            .get('appbuild'),
          10
        ) || 0;
    }

    if (!versionName) {
      versionName =
        new URLSearchParams(location.search)
          .get('appversion') || '';
    }

    versionElement.textContent =
      versionName || 'Dev';

    buildElement.textContent =
      buildCode || '?';
  }

  if (document.readyState === 'loading') {
    document.addEventListener(
      'DOMContentLoaded',
      updateDevBuildBadge
    );
  } else {
    updateDevBuildBadge();
  }
})();
</script>


<script>
(function () {
  var STORAGE_KEY = 'um_dev_onboarding_seen_v2';

  function getRememberedToken() {
    var remembered = null;
    var token = '';

    try {
      if (typeof umGetSession === 'function') {
        remembered = umGetSession();
      }
    } catch (error) {}

    if (remembered && remembered.token) {
      token = remembered.token;
    }

    if (!token) {
      try {
        token =
          sessionStorage.getItem('um_setup_token') || '';
      } catch (error) {}
    }

    return String(token || '').trim();
  }

  function normaliseToken(value) {
    return String(value || '')
      .trim()
      .replace(/[^a-zA-Z0-9_-]/g, '')
      .toUpperCase();
  }

  function setupUrl(token) {
    var url = new URL('/setup.html', location.origin);

    url.searchParams.set('native', '1');

    if (token) {
      url.searchParams.set('token', token);
    }

    if (window.ultraMaxInstalledBuild) {
      url.searchParams.set(
        'appbuild',
        String(window.ultraMaxInstalledBuild)
      );
    }

    if (window.ultraMaxInstalledVersion) {
      url.searchParams.set(
        'appversion',
        window.ultraMaxInstalledVersion
      );
    }

    return url.pathname + url.search;
  }

  function closeOnboarding(markSeen) {
    var overlay =
      document.getElementById('umOnboarding');

    if (overlay) {
      overlay.classList.remove('open');
    }

    if (markSeen) {
      try {
        localStorage.setItem(STORAGE_KEY, '1');
      } catch (error) {}
    }
  }

  function initialiseOnboarding() {
    var overlay =
      document.getElementById('umOnboarding');

    if (!overlay) return;

    var hasSeen = false;

    try {
      hasSeen =
        localStorage.getItem(STORAGE_KEY) === '1';
    } catch (error) {}

    if (hasSeen) return;

    var rememberedToken = getRememberedToken();

    var continueButton =
      document.getElementById('umContinueSetup');

    var createButton =
      document.getElementById('umCreateSetup');

    var restoreToggle =
      document.getElementById('umRestoreToggle');

    var restoreBox =
      document.getElementById('umRestoreBox');

    var restoreInput =
      document.getElementById('umRestoreToken');

    var restoreGo =
      document.getElementById('umRestoreGo');

    var restoreError =
      document.getElementById('umRestoreError');

    var exploreButton =
      document.getElementById('umExploreFirst');

    if (rememberedToken) {
      continueButton.style.display = 'block';

      continueButton.addEventListener(
        'click',
        function () {
          closeOnboarding(true);
          location.href = setupUrl(rememberedToken);
        }
      );
    }

    createButton.addEventListener(
      'click',
      function () {
        closeOnboarding(true);
        location.href = setupUrl('');
      }
    );

    restoreToggle.addEventListener(
      'click',
      function () {
        restoreBox.classList.toggle('open');

        if (restoreBox.classList.contains('open')) {
          setTimeout(function () {
            restoreInput.focus();
          }, 80);
        }
      }
    );

    function restoreSetup() {
      var token =
        normaliseToken(restoreInput.value);

      restoreInput.value = token;

      if (token.length < 4) {
        restoreError.textContent =
          'Enter a valid setup token.';
        return;
      }

      restoreError.textContent = '';

      try {
        sessionStorage.setItem(
          'um_setup_token',
          token
        );
      } catch (error) {}

      closeOnboarding(true);
      location.href = setupUrl(token);
    }

    restoreGo.addEventListener(
      'click',
      restoreSetup
    );

    restoreInput.addEventListener(
      'keydown',
      function (event) {
        if (event.key === 'Enter') {
          restoreSetup();
        }
      }
    );

    exploreButton.addEventListener(
      'click',
      function () {
        closeOnboarding(true);
      }
    );

    requestAnimationFrame(function () {
      overlay.classList.add('open');
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener(
      'DOMContentLoaded',
      initialiseOnboarding
    );
  } else {
    initialiseOnboarding();
  }
})();
</script>

