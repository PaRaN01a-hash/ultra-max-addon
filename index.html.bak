<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ultra MAX — The Ultimate Streaming Setup</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:       #080810;
      --bg2:      #0f0f1e;
      --card:     #12121f;
      --border:   #1e1e36;
      --border2:  #252542;
      --violet:   #7B2FFF;
      --violet2:  #9B5FFF;
      --coral:    #FF3D5A;
      --white:    #ffffff;
      --muted:    #8888aa;
      --text:     #e8e8f0;
    }

    html { scroll-behavior: smooth; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Inter', sans-serif;
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* ── NOISE OVERLAY ── */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 0;
    }

    /* ── HERO ── */
    .hero {
      position: relative;
      min-height: auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 120px 24px 80px;
      overflow: hidden;
    }

    /* Animated orb */
    .orb {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -60%);
      width: 700px;
      height: 700px;
      border-radius: 50%;
      background: radial-gradient(circle at 40% 40%,
        rgba(123, 47, 255, 0.35) 0%,
        rgba(255, 61, 90, 0.15) 40%,
        transparent 70%);
      filter: blur(60px);
      animation: orbPulse 6s ease-in-out infinite;
      pointer-events: none;
    }

    @keyframes orbPulse {
      0%, 100% { transform: translate(-50%, -60%) scale(1); opacity: 0.8; }
      50%       { transform: translate(-50%, -60%) scale(1.12); opacity: 1; }
    }

    /* Second orb */
    .orb2 {
      position: absolute;
      bottom: 0;
      right: -100px;
      width: 500px;
      height: 500px;
      border-radius: 50%;
      background: radial-gradient(circle,
        rgba(255, 61, 90, 0.2) 0%,
        transparent 65%);
      filter: blur(80px);
      animation: orbPulse 8s ease-in-out infinite reverse;
      pointer-events: none;
    }

    .hero-content { position: relative; z-index: 1; max-width: 900px; }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(123, 47, 255, 0.12);
      border: 1px solid rgba(123, 47, 255, 0.3);
      border-radius: 100px;
      padding: 6px 16px;
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--violet2);
      margin-bottom: 28px;
    }

    .eyebrow::before {
      content: '';
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--violet2);
      animation: blink 2s ease-in-out infinite;
    }

    @keyframes blink {
      0%, 100% { opacity: 1; }
      50%       { opacity: 0.3; }
    }

    .hero h1 {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(4rem, 14vw, 10rem);
      line-height: 0.9;
      letter-spacing: 0.02em;
      color: var(--white);
      margin-bottom: 4px;
    }

    .hero h1 .accent {
      background: linear-gradient(135deg, var(--violet) 0%, var(--coral) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-sub {
      font-size: clamp(1rem, 2.5vw, 1.3rem);
      color: var(--muted);
      font-weight: 300;
      max-width: 560px;
      margin: 20px auto 40px;
      line-height: 1.6;
    }

    .hero-sub strong { color: var(--text); font-weight: 500; }

    .scroll-hint {
      position: absolute;
      bottom: 32px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      color: var(--muted);
      font-size: 0.75rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      animation: scrollBounce 2s ease-in-out infinite;
    }

    .scroll-hint svg { opacity: 0.5; }

    @keyframes scrollBounce {
      0%, 100% { transform: translateX(-50%) translateY(0); }
      50%       { transform: translateX(-50%) translateY(6px); }
    }

    /* ── SERVICES SECTION ── */
    .services {
      position: relative;
      z-index: 1;
      padding: 80px 24px 100px;
      max-width: 1200px;
      margin: 0 auto;
    }

    .section-label {
      text-align: center;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 12px;
    }

    .section-title {
      text-align: center;
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(2rem, 5vw, 3.5rem);
      color: var(--white);
      margin-bottom: 56px;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }

    /* Laser scan card */
    .card {
      position: relative;
      background: var(--card);
      border-radius: 16px;
      padding: 40px 32px;
      overflow: hidden;
      cursor: pointer;
      text-decoration: none;
      color: inherit;
      display: block;
      transition: transform 0.3s ease, background 0.3s ease;
    }

    .card::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 16px;
      padding: 1.5px;
      background: linear-gradient(135deg, var(--violet), var(--coral), var(--violet));
      background-size: 200% 200%;
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      opacity: 0;
      transition: opacity 0.3s ease;
      animation: borderSpin 3s linear infinite paused;
    }

    .card:hover::before {
      opacity: 1;
      animation-play-state: running;
    }

    @keyframes borderSpin {
      0%   { background-position: 0% 50%; }
      50%  { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    /* Glow on hover */
    .card::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 16px;
      background: radial-gradient(circle at 50% 0%, rgba(123,47,255,0.08), transparent 60%);
      opacity: 0;
      transition: opacity 0.3s;
    }

    .card:hover { transform: translateY(-4px); background: #161628; }
    .card:hover::after { opacity: 1; }

    .card-icon {
      width: 52px; height: 52px;
      border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.6rem;
      margin-bottom: 24px;
      position: relative;
      z-index: 1;
    }

    .card-icon.violet { background: rgba(123, 47, 255, 0.15); }
    .card-icon.coral  { background: rgba(255, 61, 90, 0.12); }
    .card-icon.teal   { background: rgba(0, 210, 190, 0.12); }

    .card-tag {
      display: inline-block;
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      padding: 3px 10px;
      border-radius: 100px;
      margin-bottom: 12px;
      position: relative;
      z-index: 1;
    }

    .card-tag.violet { background: rgba(123,47,255,0.15); color: var(--violet2); }
    .card-tag.coral  { background: rgba(255,61,90,0.12); color: #ff7088; }
    .card-tag.teal   { background: rgba(0,210,190,0.12); color: #00d2be; }

    .card h3 {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 2rem;
      letter-spacing: 0.04em;
      color: var(--white);
      margin-bottom: 10px;
      position: relative;
      z-index: 1;
    }

    .card p {
      font-size: 0.9rem;
      color: var(--muted);
      line-height: 1.65;
      margin-bottom: 28px;
      position: relative;
      z-index: 1;
    }

    .card-features {
      list-style: none;
      margin-bottom: 32px;
      position: relative;
      z-index: 1;
    }

    .card-features li {
      font-size: 0.83rem;
      color: var(--muted);
      padding: 5px 0;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .card-features li::before {
      content: '';
      width: 5px; height: 5px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .card-features.violet li::before { background: var(--violet2); }
    .card-features.coral li::before  { background: #ff7088; }
    .card-features.teal li::before   { background: #00d2be; }

    .card-cta {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 0.85rem;
      font-weight: 600;
      position: relative;
      z-index: 1;
      transition: gap 0.2s;
    }

    .card-cta.violet { color: var(--violet2); }
    .card-cta.coral  { color: #ff7088; }
    .card-cta.teal   { color: #00d2be; }

    .card:hover .card-cta { gap: 12px; }

    /* ── COMMUNITY STRIP ── */
    .community {
      position: relative;
      z-index: 1;
      background: var(--bg2);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      padding: 60px 24px;
    }

    .community-inner {
      max-width: 800px;
      margin: 0 auto;
      text-align: center;
    }

    .community h2 {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(1.8rem, 4vw, 2.8rem);
      color: var(--white);
      margin-bottom: 12px;
    }

    .community p {
      color: var(--muted);
      font-size: 0.95rem;
      line-height: 1.65;
      margin-bottom: 32px;
    }

    .community-links {
      display: flex;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 24px;
      border-radius: 8px;
      font-size: 0.9rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s;
    }

    .btn-primary {
      background: var(--violet);
      color: white;
    }
    .btn-primary:hover { background: var(--violet2); transform: translateY(-2px); }

    .btn-ghost {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--text);
    }
    .btn-ghost:hover { border-color: var(--muted); transform: translateY(-2px); }

    .btn-kofi {
      background: #FF5E5B;
      color: white;
    }
    .btn-kofi:hover { opacity: 0.9; transform: translateY(-2px); }

    /* ── FOOTER ── */
    footer {
      position: relative;
      z-index: 1;
      padding: 32px 24px;
      text-align: center;
      color: var(--muted);
      font-size: 0.8rem;
    }

    footer a { color: var(--muted); text-decoration: none; }
    footer a:hover { color: var(--text); }

    /* ── NAV ── */
    nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      padding: 16px 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(8, 8, 16, 0.8);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .nav-logo {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.4rem;
      letter-spacing: 0.08em;
      color: var(--white);
      text-decoration: none;
    }

    .nav-logo span {
      background: linear-gradient(135deg, var(--violet), var(--coral));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .nav-links {
      display: flex;
      gap: 24px;
      align-items: center;
    }

    .nav-links a {
      color: var(--muted);
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: 500;
      transition: color 0.2s;
    }

    .nav-links a:hover { color: var(--text); }

    .nav-links .nav-cta {
      background: var(--violet);
      color: white;
      padding: 8px 18px;
      border-radius: 6px;
      font-size: 0.82rem;
    }

    .nav-links .nav-cta:hover { background: var(--violet2); color: white; }

    /* ── RESPONSIVE ── */
    @media (max-width: 640px) {
      nav { padding: 14px 20px; }
      .nav-links { gap: 12px; }
      .nav-links a:not(.nav-cta) { display: none; }
      .services { padding: 60px 16px 80px; }
    }

    .stats-bar {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0;
      background: var(--card);
      border: 1px solid var(--border2);
      border-radius: 14px;
      padding: 18px 32px;
      margin: 0 auto 40px;
      max-width: 600px;
      flex-wrap: wrap;
    }
    .stat-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 0 24px;
    }
    .stat-num {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 2rem;
      letter-spacing: .04em;
      color: var(--violet2);
      line-height: 1;
    }
    .stat-label {
      font-size: 11px;
      color: var(--muted);
      letter-spacing: .08em;
      text-transform: uppercase;
      margin-top: 4px;
    }
    .stat-divider {
      width: 1px;
      height: 40px;
      background: var(--border2);
    }
    @media(max-width:600px){
      .stats-bar { gap: 8px; padding: 14px 16px; }
      .stat-item { padding: 0 12px; }
      .stat-divider { display: none; }
    }

    /* Hamburger */
    .hamburger {
      display: none;
      flex-direction: column;
      gap: 5px;
      background: transparent;
      border: none;
      cursor: pointer;
      padding: 4px;
      z-index: 200;
    }
    .hamburger span {
      display: block;
      width: 24px;
      height: 2px;
      background: var(--text);
      border-radius: 2px;
      transition: all 0.3s;
    }
    .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .hamburger.open span:nth-child(2) { opacity: 0; }
    .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* Mobile Menu */
    .mobile-menu {
      display: none;
      position: fixed;
      top: 61px;
      left: 0;
      right: 0;
      background: var(--bg2);
      border-bottom: 1px solid var(--border2);
      flex-direction: column;
      padding: 16px 24px 24px;
      gap: 4px;
      z-index: 99;
    }
    .mobile-menu.open { display: flex; }
    .mobile-menu a {
      color: var(--muted);
      text-decoration: none;
      font-size: 15px;
      font-weight: 500;
      padding: 12px 0;
      border-bottom: 1px solid var(--border);
      transition: color .15s;
    }
    .mobile-menu a:last-child { border-bottom: none; }
    .mobile-menu a:hover { color: var(--text); }
    .mobile-menu .nav-cta {
      background: var(--violet);
      color: white !important;
      text-align: center;
      padding: 12px;
      border-radius: 8px;
      margin-top: 8px;
      border: none !important;
      font-weight: 700;
    }

    @media(max-width:640px){
      .hamburger { display: flex; }
      .nav-links { display: none; }
    }

    .trending-section { max-width:900px;margin:0 auto;padding:60px 24px;border-top:1px solid var(--border); }
    .section-header { text-align:center;margin-bottom:28px; }
    .section-eyebrow { font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--violet2);margin-bottom:10px; }
    .section-title { font-family:'Bebas Neue',sans-serif;font-size:clamp(1.8rem,5vw,2.8rem);letter-spacing:.04em;color:#fff;margin-bottom:8px; }
    .section-sub { font-size:14px;color:var(--muted); }
    .section-sub span { color:var(--violet2);font-weight:600; }
    .trending-grid { display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:10px; }
    .trending-item { background:var(--card);border:1px solid var(--border2);border-radius:10px;padding:12px 16px;display:flex;align-items:center;gap:12px;transition:border-color .15s; }
    .trending-item:hover { border-color:var(--violet); }
    .trending-rank { font-family:'Bebas Neue',sans-serif;font-size:1.2rem;color:var(--muted);width:22px;flex-shrink:0;text-align:center; }
    .trending-rank.top3 { color:var(--violet2); }
    .trending-icon { font-size:1.2rem;flex-shrink:0; }
    .trending-info { flex:1;min-width:0; }
    .trending-name { font-weight:600;font-size:13px;color:var(--text); }
    .trending-count { font-size:11px;color:var(--muted);margin-top:2px; }
    .trending-bar-wrap { width:50px;height:4px;background:var(--border2);border-radius:2px;flex-shrink:0; }
    .trending-bar { height:4px;background:var(--violet2);border-radius:2px; }
    .trending-loading { color:var(--muted);font-size:13px;padding:20px;text-align:center;grid-column:1/-1; }

    @media (max-width: 600px) {
      .cards {
        grid-template-columns: 1fr;
      }
    }
  
    /* ── NEW HERO ADDITIONS ── */
    .orb3 {
      position: absolute;
      top: 10%;
      left: -100px;
      width: 400px;
      height: 400px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(123,47,255,0.12) 0%, transparent 65%);
      filter: blur(70px);
      animation: orbPulse 11s ease-in-out infinite;
      pointer-events: none;
    }

    .hero { min-height: auto; padding: 120px 24px 0; padding-bottom: 0; }

    .hero h1 { line-height: 0.88; }
    .hero h1 .accent { display: block; }

    .hero-ctas {
      display: flex;
      gap: 12px;
      justify-content: center;
      margin-top: 36px;
      flex-wrap: wrap;
    }

    .btn-hero {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 14px 28px;
      border-radius: 8px;
      font-size: 0.9rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s;
    }
    .btn-hero-primary {
      background: var(--violet);
      color: white;
      box-shadow: 0 0 32px rgba(123,47,255,0.35);
    }
    .btn-hero-primary:hover {
      background: var(--violet2);
      box-shadow: 0 0 48px rgba(123,47,255,0.5);
      transform: translateY(-2px);
    }
    .btn-hero-ghost {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      color: var(--text);
    }
    .btn-hero-ghost:hover {
      background: rgba(255,255,255,0.08);
      border-color: rgba(255,255,255,0.2);
      transform: translateY(-2px);
    }

    .social-proof {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      margin-top: 28px;
    }
    .avatar-stack { display: flex; }
    .avatar-stack img {
      width: 28px; height: 28px;
      border-radius: 50%;
      border: 2px solid var(--bg);
      margin-left: -8px;
      object-fit: cover;
      background: var(--border2);
    }
    .avatar-stack img:first-child { margin-left: 0; }
    .social-text { font-size: 0.82rem; color: var(--muted); }
    .social-text strong { color: var(--violet2); font-weight: 600; }

    /* Poster strip */
    .poster-strip-wrap {
      position: relative;
      width: 100%;
      margin-top: 64px;
      overflow: hidden;
      z-index: 2;
    }
    .poster-strip-wrap::before,
    .poster-strip-wrap::after {
      content: '';
      position: absolute;
      top: 0; bottom: 0;
      width: 180px;
      z-index: 3;
      pointer-events: none;
    }
    .poster-strip-wrap::before {
      left: 0;
      background: linear-gradient(to right, var(--bg) 0%, transparent 100%);
    }
    .poster-strip-wrap::after {
      right: 0;
      background: linear-gradient(to left, var(--bg) 0%, transparent 100%);
    }
    .poster-strip {
      display: flex;
      gap: 10px;
      width: max-content;
      padding: 6px 0;
    }
    .poster-strip.row1 { animation: scrollLeft 50s linear infinite; }
    .poster-strip.row2 { animation: scrollRight 55s linear infinite; margin-top: 10px; }
    @keyframes scrollLeft {
      0%   { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    @keyframes scrollRight {
      0%   { transform: translateX(-50%); }
      100% { transform: translateX(0); }
    }
    .poster-strip:hover { animation-play-state: paused; }
    .poster-item {
      flex-shrink: 0;
      width: 90px; height: 135px;
      border-radius: 8px;
      overflow: hidden;
      border: 1px solid rgba(255,255,255,0.06);
      transition: transform 0.2s, border-color 0.2s;
    }
    .poster-item:hover {
      transform: scale(1.06) translateY(-4px);
      border-color: rgba(123,47,255,0.5);
      z-index: 1;
    }
    .poster-item img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .poster-fade {
      position: relative;
      height: 40px;
      margin-top: -40px;
      background: linear-gradient(to bottom, transparent, var(--bg));
      z-index: 3;
      pointer-events: none;
    }

    /* Logo strip */
    .logo-strip-section {
      position: relative;
      z-index: 2;
      padding: 40px 0 20px;
      overflow: hidden;
    }
    .logo-strip-label {
      text-align: center;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--muted);
      opacity: 0.6;
      margin-bottom: 20px;
    }
    .logo-strip-wrap {
      overflow: hidden;
      position: relative;
    }
    .logo-strip-wrap::before,
    .logo-strip-wrap::after {
      content: '';
      position: absolute;
      top: 0; bottom: 0;
      width: 120px;
      z-index: 2;
      pointer-events: none;
    }
    .logo-strip-wrap::before { left: 0; background: linear-gradient(to right, var(--bg), transparent); }
    .logo-strip-wrap::after  { right: 0; background: linear-gradient(to left, var(--bg), transparent); }
    .logo-strip {
      display: flex;
      width: max-content;
      gap: 48px;
      align-items: center;
      animation: scrollLeft 30s linear infinite;
      padding: 0 24px;
    }
    .logo-chip {
      display: flex;
      align-items: center;
      gap: 10px;
      opacity: 0.45;
      transition: opacity 0.2s;
      white-space: nowrap;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text);
      letter-spacing: 0.02em;
    }
    .logo-chip:hover { opacity: 0.8; }
    .logo-chip img {
      width: 22px; height: 22px;
      object-fit: contain;
      filter: brightness(10) saturate(0);
      opacity: 0.5;
    }

    @media (prefers-reduced-motion: reduce) {
      .poster-strip, .logo-strip { animation: none; }
      .orb3 { animation: none; }
    }
    @media (max-width: 640px) {
      .poster-item { width: 72px; height: 108px; }
      .hero { min-height: auto; padding-bottom: 0; }
    }

  </style>
