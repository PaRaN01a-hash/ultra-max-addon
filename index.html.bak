  <script>
  fetch('/api/shares').then(r=>r.json()).then(d=>{
    var total = d.length;
    var el = document.getElementById('galleryImports');
    if(el) el.textContent = total.toLocaleString();
  }).catch(function(){});

  fetch('/stats').then(r=>r.json()).then(d=>{
    if(d.users){
      document.getElementById('userCount').textContent = d.users.toLocaleString()+'+';
    }
  }).catch(()=>{});
  </script>

  <script>
  function toggleMenu(){
    const menu = document.getElementById('mobileMenu');
    const btn = document.getElementById('hamburger');
    menu.classList.toggle('open');
    btn.classList.toggle('open');
  }
  document.addEventListener('click', function(e){
    const menu = document.getElementById('mobileMenu');
    const btn = document.getElementById('hamburger');
    if(menu && btn && !menu.contains(e.target) && !btn.contains(e.target)){
      menu.classList.remove('open');
      btn.classList.remove('open');
    }
  });
  </script>

  <script>
  const CATALOG_NAMES = {
    trending_movies:{name:'Trending Movies',icon:'🔥'},
    trending_series:{name:'Trending Series',icon:'🔥'},
    netflix_movies:{name:'Netflix Movies',icon:'🎬'},
    netflix_series:{name:'Netflix Series',icon:'🎬'},
    amazon_movies:{name:'Prime Video Movies',icon:'📦'},
    amazon_series:{name:'Prime Video Series',icon:'📦'},
    disney_movies:{name:'Disney+ Movies',icon:'✨'},
    disney_series:{name:'Disney+ Series',icon:'✨'},
    popular_movies:{name:'Popular Movies',icon:'⭐'},
    popular_series:{name:'Popular Series',icon:'⭐'},
    hbo_movies:{name:'HBO Movies',icon:'🎭'},
    hbo_series:{name:'HBO Series',icon:'🎭'},
    apple_movies:{name:'Apple TV+ Movies',icon:'🍎'},
    apple_series:{name:'Apple TV+ Series',icon:'🍎'},
    new_movies:{name:'New Movies',icon:'🆕'},
    new_series:{name:'New Series',icon:'🆕'},
    action:{name:'Action',icon:'💥'},
    comedy:{name:'Comedy',icon:'😂'},
    horror:{name:'Horror',icon:'👻'},
    drama:{name:'Drama',icon:'🎭'},
    scifi:{name:'Science Fiction',icon:'🚀'},
    thriller:{name:'Thriller',icon:'🔪'},
    romance:{name:'Romance',icon:'💕'},
    documentary:{name:'Documentary',icon:'🎙'},
    animation:{name:'Animation',icon:'🎨'},
    anime:{name:'Anime',icon:'🌸'},
  };
  fetch('/trending').then(r=>r.json()).then(d=>{
    const grid=document.getElementById('trendingGrid');
    if(!d.trending||!d.trending.length){grid.innerHTML='<div class="trending-loading">No data yet</div>';return;}
    if(d.total)document.getElementById('trendingTotal').textContent=d.total.toLocaleString()+'+';
    const max=d.trending[0].count;
    grid.innerHTML=d.trending.map((item,i)=>{
      const info=CATALOG_NAMES[item.id]||{name:item.id.replace(/_/g,' ').replace(/ \w/g,c=>c.toUpperCase()),icon:'📋'};
      const pct=Math.round((item.count/max)*100);
      const pctUsers=Math.round((item.count/d.total)*100);
      return `<div class="trending-item">
        <div class="trending-rank ${i<3?'top3':''}">${i+1}</div>
        <div class="trending-icon">${info.icon}</div>
        <div class="trending-info">
          <div class="trending-name">${info.name}</div>
          <div class="trending-count">${pctUsers}% of users</div>
        </div>
        <div class="trending-bar-wrap"><div class="trending-bar" style="width:${pct}%"></div></div>
      </div>`;
    }).join('');
  }).catch(()=>{});
  </script>

  <script>
  // Poster strip
  const _row1Ids = ['tt0816692','tt1375666','tt0468569','tt1160419','tt15398776','tt0137523','tt0110912','tt4633694','tt1745960','tt6710474','tt0172495','tt2582802','tt1392190','tt0245429','tt3783958','tt0099685','tt0407887','tt0111161','tt0133093','tt1285016'];
  const _row2Ids = ['tt5491994','tt0903747','tt0944947','tt2861424','tt4574334','tt1520211','tt2442560','tt5180504','tt7366338','tt0386676','tt3032476','tt2306299','tt4052886','tt1475582','tt0773262','tt0108778','tt0460649','tt1316540','tt2707408','tt3581920'];
  function _makePosters(ids) {
    return ids.map(id => `<div class="poster-item"><img src="https://api.ratingposterdb.com/t0-free-rpdb/imdb/poster-default/${id}.jpg" loading="lazy" alt=""></div>`).join('');
  }
  const _r1 = document.getElementById('row1');
  const _r2 = document.getElementById('row2');
  if(_r1){ const h = _makePosters(_row1Ids); _r1.innerHTML = h + h; }
  if(_r2){ const h = _makePosters(_row2Ids); _r2.innerHTML = h + h; }
  </script>

</body>
</html>
