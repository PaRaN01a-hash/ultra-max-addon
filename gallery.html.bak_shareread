<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ultra MAX — Community Gallery</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0;}
body{background:#060610;color:#e8e8f0;font-family:'Inter',sans-serif;min-height:100vh;}

.header{background:rgba(6,6,16,0.95);border-bottom:1px solid #1a1a2e;padding:14px 20px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100;backdrop-filter:blur(12px);}
.logo{font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:.05em;color:#fff;}
.logo span{color:#ff4db8;}
.header-btns{display:flex;gap:8px;}
.btn{padding:8px 16px;border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;border:none;text-decoration:none;display:inline-flex;align-items:center;gap:5px;letter-spacing:.02em;transition:opacity .15s;}
.btn-primary{background:#7B2FFF;color:#fff;}
.btn-outline{background:transparent;border:1px solid #2a2a45;color:#888;}
.btn:hover{opacity:.8;}

.hero{padding:28px 16px 16px;text-align:center;}
.hero h1{font-family:'Bebas Neue',sans-serif;font-size:2rem;letter-spacing:.06em;margin-bottom:4px;}
.hero h1 span{color:#7B2FFF;}
.hero p{color:#444;font-size:13px;}

.tabs{display:flex;gap:6px;padding:0 16px 16px;justify-content:center;}
.tab{padding:6px 16px;border-radius:20px;font-size:12px;font-weight:700;cursor:pointer;border:1px solid #1e1e35;color:#444;background:transparent;transition:all .2s;letter-spacing:.03em;}
.tab.active{background:#7B2FFF;border-color:#7B2FFF;color:#fff;}

/* Feed */
.feed{padding:0 0 100px;}

/* Share card */
.share-card{margin-bottom:2px;background:#0a0a18;border-bottom:1px solid #1a1a2e;overflow:hidden;cursor:pointer;transition:background .15s;}
.share-card:active{background:#0d0d20;}

/* Hero image */
.card-hero{position:relative;width:100%;height:260px;overflow:hidden;background:#0a0a18;}
.card-hero-img{width:100%;height:100%;object-fit:cover;object-position:center center;display:block;}
.card-hero-gradient{position:absolute;inset:0;background:linear-gradient(to top, rgba(6,6,16,.98) 0%, rgba(6,6,16,.5) 40%, rgba(6,6,16,.05) 80%);}
.card-hero-title{position:absolute;bottom:16px;left:16px;right:80px;}
.card-hero-title h2{font-size:26px;font-weight:800;color:#fff;letter-spacing:-.02em;line-height:1.1;text-shadow:0 2px 12px rgba(0,0,0,0.9);}
.card-hero-type{display:inline-block;font-size:9px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#7B2FFF;background:rgba(123,47,255,.15);border:1px solid rgba(123,47,255,.3);border-radius:4px;padding:2px 6px;margin-bottom:6px;}

/* No hero fallback */
.card-hero-empty{width:100%;height:180px;background:linear-gradient(135deg,#0d0d20 0%,#060610 100%);display:flex;align-items:center;justify-content:center;position:relative;}
.card-hero-empty-icon{font-size:48px;opacity:.2;}

/* Folder strip */
.card-folders{padding:12px 16px;overflow-x:auto;display:flex;gap:8px;scrollbar-width:none;border-top:1px solid #2a2a45;border-bottom:1px solid #1a1a2e;background:#0d0d1e;}
.card-folders::-webkit-scrollbar{display:none;}
.folder-chip{flex-shrink:0;position:relative;border-radius:8px;overflow:hidden;width:120px;height:68px;background:#1a1a2e;border:1px solid #2a2a45;}
.folder-chip img{width:100%;height:100%;object-fit:cover;display:block;}
.folder-chip-label{position:absolute;bottom:0;left:0;right:0;padding:4px 6px;background:linear-gradient(to top,rgba(0,0,0,.95) 0%,rgba(0,0,0,.6) 60%,transparent 100%);font-size:9px;font-weight:700;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.folder-chip-empty{width:120px;height:68px;border-radius:8px;background:#1a1a2e;border:1px solid #2a2a45;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:20px;}
.folder-more{width:60px;height:62px;border-radius:8px;background:#0d0d1a;border:1px solid #1e1e35;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#444;}

/* Card meta */
.card-meta{padding:10px 16px 14px;display:flex;align-items:center;justify-content:space-between;gap:12px;background:#0d0d1e;}
.card-meta-left{}
.card-meta-author{font-size:12px;color:#666;margin-bottom:2px;}
.card-meta-stats{font-size:11px;color:#444;}
.card-meta-stats span{color:#444;}
.card-hero-import{position:absolute;bottom:16px;right:16px;background:#7B2FFF;color:#fff;border:none;border-radius:8px;padding:8px 14px;font-size:12px;font-weight:700;cursor:pointer;z-index:2;box-shadow:0 2px 12px rgba(123,47,255,.5);}
.import-btn{flex-shrink:0;background:#7B2FFF;color:#fff;border:none;border-radius:8px;padding:9px 16px;font-size:12px;font-weight:700;cursor:pointer;letter-spacing:.02em;white-space:nowrap;}
.import-btn:active{opacity:.8;}

/* Setup card variant */
.setup-hero{height:100px;background:linear-gradient(135deg,#100820 0%,#060610 100%);display:flex;align-items:center;padding:0 20px;gap:16px;position:relative;}
.setup-stat{text-align:center;}
.setup-stat-num{font-size:28px;font-weight:800;color:#a890ff;font-family:'Bebas Neue',sans-serif;letter-spacing:.02em;}
.setup-stat-label{font-size:10px;color:#444;text-transform:uppercase;letter-spacing:.08em;}
.setup-divider{width:1px;height:40px;background:#1e1e35;}

/* Import modal */
.overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.8);z-index:999;align-items:flex-end;justify-content:center;}
.overlay.open{display:flex;}
@media(min-width:600px){.overlay{align-items:center;padding:20px;}}

.modal{background:#0d0d1e;border:1px solid #2a2a45;border-radius:20px 20px 0 0;padding:24px;width:100%;max-width:520px;max-height:90vh;overflow-y:auto;}
@media(min-width:600px){.modal{border-radius:20px;}}
.modal-handle{width:36px;height:4px;background:#2a2a45;border-radius:4px;margin:0 auto 20px;}
@media(min-width:600px){.modal-handle{display:none;}}
.modal-type{font-size:9px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#7B2FFF;margin-bottom:6px;}
.modal-title{font-size:22px;font-weight:800;color:#fff;margin-bottom:4px;}
.modal-meta{font-size:12px;color:#555;margin-bottom:16px;}

/* Modal collection rows */
.modal-coll{margin-bottom:16px;}
.modal-coll-name{font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#666;margin-bottom:8px;}
.modal-coll-strip{display:flex;gap:6px;overflow-x:auto;scrollbar-width:none;padding-bottom:2px;}
.modal-coll-strip::-webkit-scrollbar{display:none;}
.modal-coll-img{width:100px;height:56px;border-radius:8px;object-fit:cover;flex-shrink:0;border:1px solid #1e1e35;}
.modal-coll-empty{width:100px;height:56px;border-radius:8px;background:#1a1a2e;flex-shrink:0;border:1px solid #1e1e35;display:flex;align-items:center;justify-content:center;font-size:18px;}
.modal-coll-folders{font-size:10px;color:#333;margin-top:4px;}

.modal-actions{display:flex;gap:10px;margin-top:20px;}
.modal-actions .btn{flex:1;justify-content:center;padding:12px;font-size:13px;}

/* Share modal */
.share-modal{background:#0d0d1e;border:1px solid #2a2a45;border-radius:20px 20px 0 0;padding:24px;width:100%;max-width:480px;}
@media(min-width:600px){.share-modal{border-radius:20px;}}
.share-modal h2{font-size:18px;font-weight:800;margin-bottom:16px;}
.field-label{font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#555;margin-bottom:6px;}
.field-input{width:100%;padding:10px 12px;background:#060610;border:1px solid #2a2a45;border-radius:8px;color:#e8e8f0;font-size:13px;margin-bottom:14px;outline:none;}
.field-input:focus{border-color:#7B2FFF;}
.share-success{background:rgba(123,47,255,.1);border:1px solid rgba(123,47,255,.3);border-radius:8px;padding:12px;margin-bottom:14px;font-size:12px;color:#a890ff;display:none;}
.share-link-row{display:flex;gap:8px;margin-bottom:14px;display:none;}
.share-link-row input{flex:1;padding:10px 12px;background:#060610;border:1px solid #2a2a45;border-radius:8px;color:#7B2FFF;font-size:12px;}

.empty{text-align:center;padding:80px 20px;color:#222;}
.empty h3{font-size:18px;font-weight:700;color:#2a2a45;margin-bottom:8px;}
.empty p{font-size:13px;color:#1a1a2e;}
.loading{text-align:center;padding:60px;color:#222;font-size:13px;}

.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#7B2FFF;color:#fff;padding:10px 20px;border-radius:20px;font-size:13px;font-weight:600;z-index:9999;opacity:0;transition:opacity .3s;pointer-events:none;white-space:nowrap;}
.toast.show{opacity:1;}
</style>
</head>
<body>

<div class="header">
  <div class="logo">ULTRA <span>MAX</span></div>
  <div class="header-btns">
    <a href="/" class="btn btn-outline">← Home</a>
    <a href="/setup" class="btn btn-primary">🚀 Builder</a>
  </div>
</div>

<div class="hero">
  <h1>Community <span>Gallery</span></h1>
  <p>Browse & import collections shared by the Ultra MAX community</p>
</div>

<div class="tabs">
  <button class="tab active" onclick="setTab('all')">All</button>
  <button class="tab" onclick="setTab('collections')">📁 Collections</button>
  <button class="tab" onclick="setTab('setup')">⚙️ Setups</button>
</div>

<div id="feed" class="feed" style="margin-top:0;">
  <div class="loading">Loading community shares...</div>
</div>

<!-- Import modal -->
<div class="overlay" id="importOverlay" onclick="closeImport(event)">
  <div class="modal" onclick="event.stopPropagation()">
    <div class="modal-handle"></div>
    <div class="modal-type" id="iType"></div>
    <div class="modal-title" id="iName"></div>
    <div class="modal-meta" id="iMeta"></div>
    <div id="iContent"></div>
    <div class="modal-actions">
      <button class="btn btn-outline" onclick="closeImport()">Cancel</button>
      <button class="btn btn-primary" id="iBtn" onclick="doImport()">⬇️ Import to Builder</button>
    </div>
  </div>
</div>

<!-- Share modal -->
<div class="overlay" id="shareOverlay" onclick="closeShare(event)">
  <div class="share-modal" onclick="event.stopPropagation()">
    <div class="modal-handle"></div>
    <h2>🔗 Share to Gallery</h2>
    <div class="field-label">What are you sharing?</div>
    <select id="shareType" class="field-input">
      <option value="collections">📁 My Collections</option>
      <option value="setup">⚙️ My Full Setup</option>
    </select>
    <div class="field-label">Give it a name</div>
    <input type="text" id="shareName" class="field-input" placeholder="e.g. Streaming Services Pack">
    <div class="field-label">Your name (optional)</div>
    <input type="text" id="shareAuthor" class="field-input" placeholder="Anonymous">
    <div class="share-success" id="shareSuccess">✅ Shared! Copy your link below and share it anywhere.</div>
    <div class="share-link-row" id="shareLinkRow">
      <input type="text" id="shareLinkInput" readonly onclick="this.select()">
      <button class="btn btn-primary" onclick="copyLink()">Copy</button>
    </div>
    <div class="modal-actions">
      <button class="btn btn-outline" onclick="closeShare()">Close</button>
      <button class="btn btn-primary" id="shareBtn" onclick="doShare()">🚀 Share</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
var _shares=[], _tab='all', _importId=null;

function escHtml(s){return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function timeAgo(iso){
  var s=Math.floor((Date.now()-new Date(iso))/1000);
  if(s<60) return 'just now';
  if(s<3600) return Math.floor(s/60)+'m ago';
  if(s<86400) return Math.floor(s/3600)+'h ago';
  return Math.floor(s/86400)+'d ago';
}

function setTab(t){
  _tab=t;
  document.querySelectorAll('.tab').forEach(function(el,i){el.classList.toggle('active',['all','collections','setup'][i]===t);});
  renderFeed();
}

function renderFeed(){
  var el=document.getElementById('feed');
  var list=_tab==='all'?_shares:_shares.filter(function(s){return s.type===_tab;});
  if(!list.length){
    el.innerHTML='<div class="empty"><h3>No shares yet</h3><p>Be the first to share from the builder!</p></div>';
    return;
  }
  el.innerHTML=list.map(function(s){ return renderCard(s); }).join('');
}

function renderCard(s){
  var heroHtml='';
  var foldersHtml='';

  if(s.type==='collections'&&s.preview&&s.preview.length){
    // Hero = first cover of first collection
    var firstCover='';
    for(var ci=0;ci<s.preview.length;ci++){
      if(s.preview[ci].covers&&s.preview[ci].covers.length){firstCover=s.preview[ci].covers[0];break;}
    }
    if(firstCover){
      heroHtml='<div class="card-hero">'
        +'<img class="card-hero-img" src="'+escHtml(firstCover)+'" onerror="this.style.display=\'none\'">'
        +'<div class="card-hero-gradient"></div>'
        +'<div class="card-hero-title"><div class="card-hero-type">📁 Collections</div><h2>'+escHtml(s.name)+'</h2></div>'
        +'<button class="card-hero-import" onclick="event.stopPropagation();openImport(\''+s.id+'\')">⬇️ Import</button>'
        +'</div>';
    } else {
      heroHtml='<div class="card-hero-empty"><div class="card-hero-gradient"></div><div class="card-hero-title"><div class="card-hero-type">📁 Collections</div><h2>'+escHtml(s.name)+'</h2></div><div class="card-hero-empty-icon">📁</div></div>';
    }
    // Folder strip = all collections as chips
    var chips='';
    var totalFolders=0;
    s.preview.forEach(function(c){
      totalFolders+=(c.folders||0);
      var img=c.covers&&c.covers[0]?'<img src="'+escHtml(c.covers[0])+'" onerror="this.style.display=\'none\';this.nextSibling.style.display=\'flex\'"><div style="display:none;width:100%;height:100%;align-items:center;justify-content:center;font-size:18px;">📁</div>':'<div style="display:flex;width:100%;height:100%;align-items:center;justify-content:center;font-size:18px;color:#2a2a45;">📁</div>';
      chips+='<div class="folder-chip">'+img+'<div class="folder-chip-label">'+escHtml(c.name||'')+'</div></div>';
    });
    foldersHtml='<div class="card-folders">'+chips+'</div>';
    var statsText=s.preview.length+' collections · '+totalFolders+' folders · '+s.imports+' imports · '+timeAgo(s.created);
    return '<div class="share-card" onclick="openImport(\''+s.id+'\')">'
      +heroHtml
      +foldersHtml
      +'<div class="card-meta"><div class="card-meta-left"><div class="card-meta-author">by '+escHtml(s.author)+'</div><div class="card-meta-stats">'+statsText+'</div></div>'
        +'</div></div>';
      +'</div></div>';

  } else if(s.type==='setup'){
    var collNames = (s.preview&&s.preview.collectionNames||[]);
    var lang = (s.preview&&s.preview.language)||'en-US';
    heroHtml='<div class="setup-hero" style="flex-direction:column;align-items:flex-start;height:auto;padding:16px;">'
      +'<div class="card-hero-type" style="position:static;margin-bottom:6px;">⚙️ Setup</div>'
      +'<h2 style="font-size:20px;font-weight:800;color:#fff;margin-bottom:10px;">'+escHtml(s.name)+'</h2>'
      +'<div style="display:flex;gap:16px;margin-bottom:12px;">'
      +'<div class="setup-stat"><div class="setup-stat-num">'+(s.preview&&s.preview.catalogs||0)+'</div><div class="setup-stat-label">Home Rows</div></div>'
      +'<div class="setup-divider"></div>'
      +'<div class="setup-stat"><div class="setup-stat-num">'+(s.preview&&s.preview.collections||0)+'</div><div class="setup-stat-label">Collections</div></div>'
      +'<div class="setup-divider"></div>'
      +'<div class="setup-stat"><div class="setup-stat-num" style="font-size:16px;">'+escHtml(lang)+'</div><div class="setup-stat-label">Language</div></div>'
      +'</div>'
      +(collNames.length?'<div style="display:flex;flex-wrap:wrap;gap:5px;">'
        +collNames.map(function(n){return '<div style="background:#1a1a35;border:1px solid #2a2a45;border-radius:6px;padding:3px 8px;font-size:10px;font-weight:600;color:#a890ff;">'+escHtml(n)+'</div>';}).join('')
        +'</div>':'')
      +'</div>';
    return '<div class="share-card" onclick="openImport(\''+s.id+'\')">'
      +heroHtml
      +'<div class="card-meta"><div class="card-meta-left"><div class="card-meta-author">by '+escHtml(s.author)+'</div><div class="card-meta-stats">'+s.imports+' imports · '+timeAgo(s.created)+'</div></div>'
      +'<button class="import-btn" onclick="event.stopPropagation();openImport(\''+s.id+'\')">Import</button>'
      +'</div></div>';
  }
  return '';
}

function openImport(id){
  var s=_shares.find(function(x){return x.id===id;});
  if(!s) return;
  _importId=id;
  document.getElementById('iType').textContent=s.type==='collections'?'📁 Collections':'⚙️ Setup';
  document.getElementById('iName').textContent=s.name;
  document.getElementById('iMeta').textContent='By '+s.author+' · '+(s.imports||0)+' imports · '+timeAgo(s.created);
  var content=document.getElementById('iContent');
  content.innerHTML='';
  if(s.type==='collections'&&s.preview){
    s.preview.forEach(function(c){
      var div=document.createElement('div');
      div.className='modal-coll';
      var nameEl=document.createElement('div');
      nameEl.className='modal-coll-name';
      nameEl.textContent=(c.name||'Collection')+' · '+(c.folders||0)+' folders';
      div.appendChild(nameEl);
      var strip=document.createElement('div');
      strip.className='modal-coll-strip';
      if(c.covers&&c.covers.length){
        c.covers.forEach(function(url){
          var img=document.createElement('img');
          img.src=url; img.className='modal-coll-img';
          img.onerror=function(){this.style.display='none';};
          strip.appendChild(img);
        });
      } else {
        strip.innerHTML='<div class="modal-coll-empty">📁</div>';
      }
      div.appendChild(strip);
      content.appendChild(div);
    });
  } else if(s.type==='setup'&&s.preview){
    content.innerHTML='<div style="display:flex;gap:20px;padding:12px 0;">'
      +'<div class="setup-stat"><div class="setup-stat-num">'+(s.preview.catalogs||0)+'</div><div class="setup-stat-label">Home Rows</div></div>'
      +'<div class="setup-stat"><div class="setup-stat-num">'+(s.preview.collections||0)+'</div><div class="setup-stat-label">Collections</div></div>'
      +'</div>';
  }
  document.getElementById('iBtn').textContent='⬇️ Import to Builder';
  document.getElementById('iBtn').disabled=false;
  document.getElementById('importOverlay').classList.add('open');
}

function closeImport(e){
  if(e&&e.target!==document.getElementById('importOverlay')) return;
  document.getElementById('importOverlay').classList.remove('open');
}

function doImport(importType){
  if(!_importId) return;
  var btns=document.querySelectorAll('#importOptions button');
  btns.forEach(function(b){b.disabled=true;});
  fetch('/api/share/'+_importId)
    .then(function(r){return r.json();})
    .then(function(share){
      var d=share.data;
      if(importType==='both'||importType==='collections'){
        var colls=d.collections||(share.type==='collections'?d:[]);
        sessionStorage.setItem('um_import_collections',JSON.stringify(colls));
      }
      if(importType==='both'||importType==='setup'){
        var setup=d.setup||{catalogs:d.catalogs||[],collections:d.collections||[],language:d.language||'',displayStyle:d.displayStyle||''};
        sessionStorage.setItem('um_import_setup',JSON.stringify(setup));
      }
      sessionStorage.setItem('um_import_type',importType);
      showToast('Redirecting to builder...');
      setTimeout(function(){window.location.href='/setup.html?import=gallery';},1000);
    })
    .catch(function(){showToast('Import failed');btns.forEach(function(b){b.disabled=false;});});
}
      showToast('Redirecting to builder...');
      setTimeout(function(){window.location.href='/setup.html?import=gallery';},1000);
    })
    .catch(function(){showToast('Import failed');btn.textContent='⬇️ Import to Builder';btn.disabled=false;});
}

function openShare(){
  document.getElementById('shareSuccess').style.display='none';
  document.getElementById('shareLinkRow').style.display='none';
  document.getElementById('shareBtn').textContent='🚀 Share';
  document.getElementById('shareBtn').disabled=false;
  document.getElementById('shareOverlay').classList.add('open');
}
function closeShare(e){
  if(e&&e.target!==document.getElementById('shareOverlay')) return;
  document.getElementById('shareOverlay').classList.remove('open');
}

function doShare(){
  var type=document.getElementById('shareType').value;
  var name=document.getElementById('shareName').value.trim();
  var author=document.getElementById('shareAuthor').value.trim()||'Anonymous';
  if(!name){showToast('Please enter a name');return;}
  var raw=localStorage.getItem(type==='collections'?'um_share_collections':'um_share_setup');
  if(!raw){showToast('Open the builder first, then come back to share');return;}
  var data; try{data=JSON.parse(raw);}catch(e){showToast('Invalid data');return;}
  var btn=document.getElementById('shareBtn');
  btn.textContent='Sharing...'; btn.disabled=true;
  fetch('/api/share',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({type,name,author,data})})
    .then(function(r){return r.json();})
    .then(function(res){
      if(res.error){showToast('Error: '+res.error);btn.textContent='🚀 Share';btn.disabled=false;return;}
      document.getElementById('shareLinkInput').value=res.url;
      document.getElementById('shareSuccess').style.display='block';
      document.getElementById('shareLinkRow').style.display='flex';
      btn.textContent='✅ Shared!';
      loadShares();
    })
    .catch(function(){showToast('Share failed');btn.textContent='🚀 Share';btn.disabled=false;});
}

function copyLink(){
  document.getElementById('shareLinkInput').select();
  document.execCommand('copy');
  showToast('Link copied!');
}

function showToast(msg){
  var t=document.getElementById('toast');
  t.textContent=msg; t.classList.add('show');
  setTimeout(function(){t.classList.remove('show');},2500);
}

function loadShares(){
  fetch('/api/shares')
    .then(function(r){return r.json();})
    .then(function(data){_shares=data;renderFeed();})
    .catch(function(){document.getElementById('feed').innerHTML='<div class="loading">Could not load — try refreshing</div>';});
}

var params=new URLSearchParams(window.location.search);
var importId=params.get('import');
var shareMode=params.get('share');

if(shareMode==='1'){
  if(document.readyState==='complete'){
    setTimeout(openShare,100);
  } else {
    window.addEventListener('load',function(){ setTimeout(openShare,100); });
  }
}

if(importId){
  fetch('/api/share/'+importId)
    .then(function(r){return r.json();})
    .then(function(share){
      _shares=[{
        id:share.id,type:share.type,name:share.name,author:share.author,
        created:share.created,imports:share.imports,
        preview:share.type==='collections'
          ?(share.data||[]).slice(0,5).map(function(c){return{name:c.title||c.name||'Collection',folders:(c.folders||[]).length,covers:(c.folders||[]).slice(0,5).map(function(f){return f.coverImageUrl;}).filter(Boolean)};})
          :{catalogs:Array.isArray(share.data&&share.data.catalogs)?share.data.catalogs.length:0,collections:Array.isArray(share.data&&share.data.collections)?share.data.collections.length:0}
      }];
      renderFeed();
      setTimeout(function(){openImport(importId);},300);
    });
}

loadShares();
</script>
</body>
</html>
