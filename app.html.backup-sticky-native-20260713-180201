  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #080810; --border: #1e1e36; --border2: #2a2a45;
      --violet: #7B2FFF; --violet2: #9B5FFF; --coral: #FF3D5A;
      --text: #e8e8f0; --muted: #8888aa; --ok: #34d399;
    }
    html, body { height: 100%; background: var(--bg); color: var(--text);
      font-family: 'Inter', sans-serif; font-size: 15px; overflow-x: hidden; touch-action: pan-y; }
    body::before{content:'';position:fixed;inset:0;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");pointer-events:none;z-index:0;}
    #particles{position:fixed;inset:0;pointer-events:none;z-index:0;overflow:hidden;}
    .particle{position:absolute;border-radius:50%;animation:floatUp linear infinite;}
    @keyframes floatUp{0%{transform:translateY(0) translateX(0);opacity:0;}10%{opacity:1;}90%{opacity:.6;}100%{transform:translateY(-100vh) translateX(var(--dx));opacity:0;}}
    #cursorGlow{position:fixed;pointer-events:none;z-index:1;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(123,47,255,0.08) 0%,transparent 70%);transform:translate(-50%,-50%);mix-blend-mode:screen;}
    .hero-orb { position:fixed;top:-100px;left:50%;transform:translateX(-50%);width:750px;height:550px;border-radius:50%;background:radial-gradient(circle,rgba(123,47,255,0.32) 0%,transparent 70%);filter:blur(80px);pointer-events:none;z-index:0;animation:orbPulse 7s ease-in-out infinite; }
    .hero-orb-2 { position:fixed;bottom:-180px;left:-150px;width:550px;height:550px;border-radius:50%;background:radial-gradient(circle,rgba(255,61,90,0.28) 0%,transparent 70%);filter:blur(80px);pointer-events:none;z-index:0;animation:orbPulse 9s ease-in-out infinite 1s; }
    .hero-orb-3 { position:fixed;bottom:-150px;right:-180px;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(52,211,153,0.26) 0%,transparent 70%);filter:blur(80px);pointer-events:none;z-index:0;animation:orbPulse 8s ease-in-out infinite 2s; }
    @keyframes orbPulse{0%,100%{opacity:.7;}50%{opacity:1;}}

    .wrap { max-width: 640px; margin: 0 auto; padding: 40px 20px 0; position: relative; z-index: 2; }

    .header { text-align: center; margin-bottom: 32px; }
    .app-icon { width: 96px; height: 96px; border-radius: 26px; margin: 0 auto 18px;
      box-shadow: 0 12px 40px rgba(123,47,255,.45), 0 0 0 1px rgba(255,255,255,.06); display: block; }
    .logo { font-family: 'Bebas Neue', sans-serif; font-size: 40px; letter-spacing: .06em; margin-bottom: 5px; }
    .logo span { background: linear-gradient(135deg, var(--violet), var(--coral));
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .tagline { color: var(--muted); font-size: 15px; }

    .continue-card {
      background: linear-gradient(135deg, rgba(52,211,153,.14), rgba(52,211,153,.05));
      border: 1px solid rgba(52,211,153,.35); border-radius: 22px; padding: 22px 24px;
      margin-bottom: 22px; text-decoration: none; display: none; align-items: center; gap: 16px;
    }
    .continue-icon { width: 50px; height: 50px; border-radius: 14px; background: var(--ok); flex-shrink: 0;
      display: flex; align-items: center; justify-content: center; }
    .continue-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
      color: var(--ok); margin-bottom: 4px; }
    .continue-title { font-size: 18px; font-weight: 700; color: #fff; }

    .tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .tile {
      background: linear-gradient(160deg, rgba(255,255,255,.06), rgba(255,255,255,.02));
      border: 1px solid var(--border); border-radius: 28px; padding: 30px 22px;
      text-decoration: none; color: var(--text); display: flex; flex-direction: column;
      justify-content: space-between; align-items: center; text-align: center; gap: 24px;
      position: relative; overflow: hidden; min-height: 240px;
    }
    .tile-pulse { position: absolute; inset: -1px; border-radius: 28px; border: 1px solid var(--tile-clr, var(--violet)); opacity: 0; }
    .tile:active .tile-pulse { animation: pulseBorder .6s ease-out; }
    .tile:active { background: linear-gradient(160deg, rgba(255,255,255,.09), rgba(255,255,255,.03)); }
    @keyframes pulseBorder { 0% { opacity: .9; transform: scale(1); } 100% { opacity: 0; transform: scale(1.04); } }

    .tile-badge {
      width: 80px; height: 80px; border-radius: 22px; display: flex; align-items: center; justify-content: center;
      background: var(--tile-clr);
      background: linear-gradient(140deg, var(--tile-clr), color-mix(in srgb, var(--tile-clr) 60%, black));
      box-shadow: 0 8px 24px color-mix(in srgb, var(--tile-clr) 45%, transparent);
    }
    .tile-badge svg { width: 38px; height: 38px; }
    .tile-name { font-size: 18px; font-weight: 700; color: #fff; margin-bottom: 5px; }
    .tile-desc { font-size: 13px; color: var(--muted); line-height: 1.4; }

    .tile-wide { grid-column: 1 / -1; flex-direction: row; align-items: center; justify-content: center; text-align: left; min-height: auto; padding: 22px 26px; gap: 18px; }
    .tile-wide .tile-badge { width: 58px; height: 58px; flex-shrink: 0; border-radius: 17px; }
    .tile-wide .tile-badge svg { width: 28px; height: 28px; }
    .tile-wide .tile-text { flex: 0 1 auto; text-align: left; }
    .tile-wide .tile-name { margin-bottom: 3px; }

    .footer-links { display: flex; justify-content: center; gap: 22px; margin-top: 30px; position: relative; z-index: 2; }
    .footer-links a { font-size: 13px; color: var(--muted); text-decoration: none; }

    .poster-strip-wrap { position: relative; width: 100%; margin-top: 36px; overflow: hidden; z-index: 2; }
    .poster-strip-wrap::before, .poster-strip-wrap::after {
      content: ''; position: absolute; top: 0; bottom: 0; width: 60px; z-index: 3; pointer-events: none;
    }
    .poster-strip-wrap::before { left: 0; background: linear-gradient(to right, var(--bg) 0%, transparent 100%); }
    .poster-strip-wrap::after { right: 0; background: linear-gradient(to left, var(--bg) 0%, transparent 100%); }
    .poster-strip { display: flex; gap: 8px; width: max-content; padding: 4px 0; }
    .poster-strip.row1 { animation: scrollLeft 45s linear infinite; }
    .poster-strip.row2 { animation: scrollRight 50s linear infinite; margin-top: 8px; }
    @keyframes scrollLeft { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
    @keyframes scrollRight { 0% { transform: translateX(-50%); } 100% { transform: translateX(0); } }
    .poster-item { flex-shrink: 0; width: 62px; height: 93px; border-radius: 7px; overflow: hidden; border: 1px solid rgba(255,255,255,0.06); }
    .poster-item img { width: 100%; height: 100%; object-fit: cover; display: block; }

    .stats-bar { display: flex; justify-content: center; align-items: center; gap: 0; margin: 36px auto 40px;
      max-width: 640px; padding: 0 20px; position: relative; z-index: 2; flex-wrap: wrap; }
    .stat-item { text-align: center; padding: 0 20px; }
    .stat-num { font-family: 'Bebas Neue', sans-serif; font-size: 26px; letter-spacing: .04em;
      background: linear-gradient(135deg, var(--violet2), var(--coral));
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .stat-label { font-size: 11px; color: var(--muted); margin-top: 2px; text-transform: uppercase; letter-spacing: .06em; }
    .stat-divider { width: 1px; height: 32px; background: var(--border2); }
    .section-label { text-align: center; font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
      color: var(--violet2); margin: 8px 0 14px; position: relative; z-index: 2; }
  </style>
</head>
