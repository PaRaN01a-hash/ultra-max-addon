<script>
(function () {
  function activateNativeMode() {
    try {
      var hasCapacitor =
        window.Capacitor &&
        typeof window.Capacitor.isNativePlatform === 'function' &&
        window.Capacitor.isNativePlatform();

      var userAgent = navigator.userAgent || '';

      var isAndroidWebView =
        /; wv\)/i.test(userAgent) ||
        (/Android/i.test(userAgent) && /Version\/4\.0/i.test(userAgent));

      var forcedNative =
        new URLSearchParams(window.location.search).get('native') === '1';

      var isNative =
        forcedNative || hasCapacitor || isAndroidWebView;

      if (!isNative) return;

      document.documentElement.classList.add('native-app');

      var currentPage =
        window.location.pathname.split('/').pop() || 'app.html';

      document.querySelectorAll('.app-bottom-nav a').forEach(function (link) {
        link.classList.toggle(
          'active',
          link.dataset.appPage === currentPage
        );
      });
    } catch (error) {
      console.warn('Ultra MAX native detection failed:', error);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', activateNativeMode);
  } else {
    activateNativeMode();
  }
})();
</script>

