<script>
(function(){
  var remembered = (typeof umGetSession === 'function') ? umGetSession() : null;
  var token = remembered ? remembered.token : null;
  if (!token) {
    try { token = sessionStorage.getItem('um_setup_token'); } catch(e){}
  }
  if (token) {
    var card = document.getElementById('continueCard');
    card.href = '/setup.html?token=' + token;
    card.style.display = 'flex';
  }
})();

(function(){
  const c = document.getElementById('particles');
  if (!c) return;
  for (let i = 0; i < 40; i++) {
    const p = document.createElement('div'); p.className = 'particle';
    const r = Math.random();
    const clr = r < 0.2 ? 'rgba(123,47,255,0.7)' : r < 0.3 ? 'rgba(255,61,90,0.5)' : 'rgba(255,255,255,0.4)';
    p.style.cssText = `width:${Math.random()*2+.5}px;height:${Math.random()*2+.5}px;left:${Math.random()*100}%;bottom:-10px;background:${clr};--dx:${(Math.random()-.5)*60}px;animation-duration:${Math.random()*20+15}s;animation-delay:-${Math.random()*20}s;`;
    c.appendChild(p);
  }
})();

const _glow = document.getElementById('cursorGlow');
if (_glow) document.addEventListener('mousemove', e => { _glow.style.left = e.clientX + 'px'; _glow.style.top = e.clientY + 'px'; });

(function(){
  const row1Ids = ['tt0816692','tt1375666','tt0468569','tt1160419','tt15398776','tt0137523','tt0110912','tt4633694','tt1745960','tt6710474','tt0172495','tt2582802'];
  const row2Ids = ['tt5491994','tt0903747','tt0944947','tt2861424','tt4574334','tt1520211','tt2442560','tt5180504','tt7366338','tt0386676','tt3032476','tt2306299'];
  const row3Ids = ['tt1392190','tt0910970','tt2395427','tt3896198','tt4154756','tt6320628','tt7695844','tt8503618','tt10160804','tt11358390','tt7126948','tt9032400'];
  const row4Ids = ['tt2707408','tt1316540','tt4052886','tt3530232','tt5171438','tt4158110','tt2935510','tt0773262','tt0460649','tt8111088','tt1682180','tt7610588'];
  function makePosters(ids) {
    return ids.map(id => `<div class="poster-item"><img src="https://api.ratingposterdb.com/t0-free-rpdb/imdb/poster-default/${id}.jpg" loading="lazy" alt=""></div>`).join('');
  }
  const r1 = document.getElementById('row1');
