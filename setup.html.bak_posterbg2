function _importProjectFile(event){
  const file = event.target.files && event.target.files[0];
  if(!file){ showBanner('No file selected', 'error'); return; }

  showBanner('📂 Reading file: ' + file.name, 'success');

  const reader = new FileReader();
  reader.onload = function(e){
    try{
      const raw = e.target.result;
      showBanner('📋 Parsing JSON...', 'success');
      const data = JSON.parse(raw);
      showBanner('🔧 Importing data...', 'success');
      importProjectData(data);
      saveDraftState();
      showBanner('✅ Project imported successfully!', 'success');
    }catch(err){
      console.error('Import error:', err);
      showBanner('❌ Import failed: ' + err.message, 'error');
    }finally{
      event.target.value = '';
    }
  };
  reader.onerror = function(e){
    showBanner('❌ Could not read file: ' + (e.target.error || 'unknown error'), 'error');
  };
  reader.readAsText(file);
}




