window.checkStreamWizardAddon = async function(){
  const input = document.getElementById('streamWizardUrl');
  const result = document.getElementById('streamWizardResult');
  if(!input || !result) return;

  const url = input.value.trim();
  if(!url){ 
    result.innerHTML = '<div class="stream-checking">⚠️ Please paste a manifest URL first.</div>';
    return;
  }

  result.innerHTML = '<div class="stream-checking">⏳ Checking addon...</div>';

  try {
    const res = await fetch(url, { method: 'GET' });
    if(!res.ok) throw new Error('HTTP ' + res.status);
    const manifest = await res.json();
    
    if(!manifest.id || !manifest.name){
      throw new Error('Not a valid Stremio addon manifest');
    }

    // Add to stream addons
    const addons = getStoredStreamAddons ? getStoredStreamAddons() : [];
    if(!addons.includes(url)){
      addons.push(url);
      if(typeof setStoredStreamAddons === 'function') setStoredStreamAddons(addons);
    }
    if(typeof markStreamProviderAdded === 'function') markStreamProviderAdded(url);
    if(typeof renderStreamAddonCards === 'function') renderStreamAddonCards();

    result.innerHTML = '<div class="stream-checking" style="color:#00d2a0;">✅ <strong>' + manifest.name + '</strong> (v' + manifest.version + ') added successfully!</div>';
    input.value = '';

    // Hide instruction box
    const instrBox = document.getElementById("streamQuickInstructions");
    if(instrBox) instrBox.style.display = 'none';

  } catch(e) {
    result.innerHTML = '<div class="stream-checking" style="color:#FF3D5A;">❌ Could not load addon: ' + e.message + '. Make sure the URL ends in /manifest.json</div>';
  }
};

function shortStreamUrl(url){
