.banner-msg{
position:fixed;
top:18px;
left:50%;
transform:translateX(-50%);
z-index:9999;
min-width:280px;
max-width:90%;
padding:14px 18px;
border-radius:10px;
font-size:13px;
line-height:1.5;
box-shadow:0 10px 30px rgba(0,0,0,.45);
border:1px solid #222;
background:#0d0d0d;
color:#fff;
animation:fadeIn .2s ease;
}
.banner-success{border-color:#2f6b3b;}
.banner-error{border-color:#7b2e2e;}
@keyframes fadeIn{
from{opacity:0;transform:translateX(-50%) translateY(-8px);}
to{opacity:1;transform:translateX(-50%) translateY(0);}
}


.page1-section-label{
  margin:28px 0 8px;
  font-size:22px;
  font-weight:700;
  letter-spacing:.03em;
  color:#fff;
}
.page1-section-label.optional{
