    btn.style.display = 'inline-block';
    btn.disabled = !matches.length || alreadyAdded;
    btn.style.opacity = (!matches.length || alreadyAdded) ? '0.35' : '1';
    btn.title = alreadyAdded ? 'Already added' : (!matches.length ? 'No available rows' : '');
  });
}

