  opacity:0.55;
}

.step-1 .input-hint{
  color:#8a8a8a;
  font-size:11px;
  line-height:1.6;
  margin-top:8px;
}

.step-1 .info-box{
  background:#0d0d0d;
  border-color:#222;
}

.step-1 .returning-wrap{
